import { ScrollView, Palette, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct TreeItemData {
    label: string,
    path_key: string,
    depth: int,
    selected: bool,
    has_children: bool,
    is_expanded: bool,
}

export struct RecentFolderData {
    name: string,
    parent_path: string,
    full_path: string,
    active: bool,
}

export struct OpenWithAppItem {
    id: int,
    name: string,
    icon: image,
    has_icon: bool,
}

export struct FilmstripItemData {
    label: string,
    rel_path: string,
    full_path: string,
    thumbnail: image,
    has_thumbnail: bool,
    selected: bool,
    badge_type: string,
    badge_text: string,
    rating: int,
    is_cropped: bool,
}

export struct MultiSelectTileData {
    full_path: string,
    label: string,
    thumbnail: image,
    has_thumbnail: bool,
    is_ellipsis: bool,
    ellipsis_text: string,
    rating: int,
    badge_text: string,
    badge_type: string,
    tile_x: length,
    tile_y: length,
    tile_w: length,
    tile_h: length,
    is_cropped: bool,
}

export struct MetadataRowData {
    key: string,
    value: string,
}

export struct ZoomPreset {
    label: string,
    factor: float,
}

export struct ShortcutItemData {
    id: string,
    name: string,
    key_combo: string,
    is_valid: bool,
}


component ChevronDown inherits Image {
    in property <color> stroke: #8E8E8E;
    width: 11px;
    height: 11px;
    source: @image-url("../assets/icons/chevron_down.svg");
    colorize: root.stroke;
    image-fit: contain;
}

component ChevronRight inherits Image {
    in property <color> stroke: #8E8E8E;
    width: 11px;
    height: 11px;
    source: @image-url("../assets/icons/chevron_right.svg");
    colorize: root.stroke;
    image-fit: contain;
}

component C1FolderIcon inherits Image {
    in property <color> stroke: #B0B0B0;
    width: 16px;
    height: 16px;
    source: @image-url("../assets/icons/folder.svg");
