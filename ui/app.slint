}

component Win10Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <string> icon-text: "";
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked;

    height: 30px;
    horizontal-stretch: 0;
    background: touch.pressed ? #3F3F3F : (touch.has-hover ? (primary ? #363636 : #303030) : (primary ? #2C2C2C : #242424));
    border-width: 1px;
    border-color: touch.pressed ? #4C4C4C : (touch.has-hover ? (primary ? #5A5A5A : #444444) : (primary ? #484848 : #383838));
    border-radius: 3px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        if root.has-icon : Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            image-fit: contain;
            colorize: touch.has-hover ? #FFFFFF : #B0B0B0;
            y: (parent.height - self.height) / 2.0;
        }
        if !root.has-icon && icon-text != "" : Text {
            text: icon-text;
            color: touch.has-hover ? #E2E2E2 : #B0B0B0;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        if text != "" : Text {
            text: root.text;
            color: touch.has-hover ? #E2E2E2 : #B0B0B0;
            font-size: 12px;
            font-weight: primary ? 600 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Win10CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 30px;
    horizontal-stretch: 0;
    background: transparent;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2.0;
            background: root.checked ? #9A9A9A : (cb-touch.has-hover ? #2A2A2A : #1C1C1C);
            border-width: 1px;
            border-color: root.checked ? #BCBCBC : (cb-touch.has-hover ? #5A5A5A : #3C3C3C);
            border-radius: 3px;

            if root.checked : Image {
                source: @image-url("../assets/icons/check.svg");
                width: 12px;
                height: 12px;
                image-fit: contain;
                colorize: #121212;
                x: (parent.width - self.width) / 2.0;
                y: (parent.height - self.height) / 2.0;
            }
        }

        Text {
            text: root.text;
            color: cb-touch.has-hover ? #E2E2E2 : #B0B0B0;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    cb-touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component AppWindow inherits Window {
    // Program name, version and platform come from Rust (Cargo.toml is the single source).
    in property <string> app-name;
    in property <string> app-version;
    in property <string> platform-label;
    // File name of the image on the canvas, used in the window title ("photo.jpg — Horama").
    in property <string> current-file-name;
    title: root.has-image && root.current-file-name != "" ? root.current-file-name + " — " + root.app-name : root.app-name;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1024px;
    min-height: 680px;
    background: #161616;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    // Saved Custom Aspect Ratios (Tasks 4, 5)
    in-out property <[string]> saved-custom-aspect-ratios: [];
    callback save-custom-aspect-ratio(string);
    callback delete-custom-aspect-ratio(string);

    // Unsaved modifications & exit confirmation (Task 20)
    in-out property <bool> exit-confirm-dialog-visible: false;
    in-out property <string> exit-confirm-text: "There are unsaved modifications. Are you sure you want to exit?";
    callback request-exit();
    callback save-all-modified-and-exit();

    // Modification filter checkboxes (Task 21)
    in-out property <bool> filter-is-cropped: false;
    in-out property <bool> filter-is-profile-modified: false;

    // Menubar & Sidebar States
    in-out property <length> left-panel-width: 250px;
    in-out property <length> right-panel-width: 275px;
    in-out property <bool> left-panel-visible: true;
    in-out property <bool> right-panel-visible: true;
    property <bool> file-menu-open: false;
    property <bool> edit-menu-open: false;
    property <bool> view-menu-open: false;
    property <bool> help-menu-open: false;
    property <bool> about-dialog-visible: false;
    callback exit-app();
    callback canvas-double-clicked(float, float, float, float);

    // Keyboard Shortcuts Customization
    in-out property <bool> shortcuts-dialog-visible: false;
    in-out property <[ShortcutItemData]> shortcut-items: [];
    callback update-shortcut-key(int, string);
    callback reset-shortcuts-to-default();
    callback save-shortcuts-and-close();
    callback get-action-for-shortcut(string) -> string;

    pure function key-to-string(key-text: string, ctrl: bool, shift: bool) -> string {
        let prefix = (ctrl ? "Ctrl+" : "") + (shift ? "Shift+" : "");
        if (key-text == Key.LeftArrow) { return prefix + "Left"; }
        if (key-text == Key.RightArrow) { return prefix + "Right"; }
        if (key-text == Key.UpArrow) { return prefix + "Up"; }
        if (key-text == Key.DownArrow) { return prefix + "Down"; }
        if (key-text == Key.Delete) { return prefix + "Delete"; }
        if (key-text == Key.F2) { return prefix + "F2"; }
        if (key-text == Key.F5) { return prefix + "F5"; }
        if (key-text == Key.Space) { return prefix + "Space"; }
        if (key-text == Key.Return) { return prefix + "Enter"; }
        if (key-text == Key.Escape) { return prefix + "Esc"; }
        return prefix + key-text;
    }

    // Filters & Multi-Criteria Search (Tasks 2, 3, 4)
    in-out property <string> filter-search-text: "";
    in-out property <bool> filter-r0: false;
    in-out property <bool> filter-r1: false;
    in-out property <bool> filter-r2: false;
    in-out property <bool> filter-r3: false;
    in-out property <bool> filter-r4: false;
    in-out property <bool> filter-r5: false;
    in-out property <string> filter-color-profile: "ALL";
    in-out property <bool> filter-profile-menu-open: false;
    in-out property <string> filter-aspect-ratio: "ALL";
    in-out property <bool> filter-aspect-menu-open: false;

    pure function ratings-mask() -> int {
        (root.filter-r0 ? 1 : 0) + (root.filter-r1 ? 2 : 0) + (root.filter-r2 ? 4 : 0) + (root.filter-r3 ? 8 : 0) + (root.filter-r4 ? 16 : 0) + (root.filter-r5 ? 32 : 0)
    }

    pure function has-active-rating-filter() -> bool {
        root.filter-r0 || root.filter-r1 || root.filter-r2 || root.filter-r3 || root.filter-r4 || root.filter-r5
    }

    public function clear-ratings() {
        root.filter-r0 = false;
        root.filter-r1 = false;
        root.filter-r2 = false;
        root.filter-r3 = false;
        root.filter-r4 = false;
        root.filter-r5 = false;
    }

    public function trigger-filter-update() {
        root.filter-changed-advanced(
            root.filter-search-text,
            root.ratings-mask(),
            root.filter-aspect-ratio,
            root.filter-color-profile,
            root.filter-is-cropped,
            root.filter-is-profile-modified
        );
    }

    callback filter-changed-advanced(string, int, string, string, bool, bool);
    callback filter-clear-clicked();

    // Window Drag Offsets (Task 2)
    in-out property <length> shortcuts-dialog-offset-x: 0px;
    in-out property <length> shortcuts-dialog-offset-y: 0px;

    public function open-shortcuts-dialog() {
        root.shortcuts-dialog-visible = true;
    }

    // --- State Properties ---
    in-out property <[string]> profile-list: [
        "Embedded Profile",
        "sRGB IEC61966-2.1",
        "Adobe RGB (1998)",
        "ProPhoto RGB (ROMM RGB)",
        "Display P3",
        "Rec.2020",
        "Rec.709",
        "Wide Gamut RGB",
        "CIE RGB",
        "Apple RGB",
        "Load Custom ICC/ICM Profile..."
    ];
    in-out property <string> current-profile: "sRGB IEC61966-2.1";
    in-out property <string> embedded-badge-text: "No Image";
    in-out property <bool> has-embedded-icc: false;
    in-out property <bool> lock-profile: false;
    in-out property <bool> lock-zoom: false;

    in-out property <string> zoom-text: "100%";
    in-out property <float> zoom-factor: 1.0;
    // Physical-to-logical pixel ratio of the window (Windows display scaling). zoom-factor is
    // expressed in physical pixels so that 100% really means one image pixel per screen pixel.
    in property <float> display-scale: 1.0;
    property <float> view-zoom: root.zoom-factor / max(0.25, root.display-scale);
    in-out property <float> pan-x: 0.0;
    in-out property <float> pan-y: 0.0;
    out property <float> canvas-width: canvas-area.width / 1px;
    out property <float> canvas-height: canvas-area.height / 1px;

    callback window-resized();

    changed canvas-width => {
        root.window-resized();
    }
    changed canvas-height => {
        root.window-resized();
    }

    in-out property <string> folder-path: "";
    in-out property <bool> has-subfolders: false;
    in-out property <[TreeItemData]> folder-tree-items: [];
    in-out property <[RecentFolderData]> recent-folders: [];
    in-out property <[FilmstripItemData]> filmstrip-items: [];

    in-out property <image> current-image;
    // Notice in the canvas (see notice-row): text, error style, optional action button.
    in property <bool> notice-visible: false;
    in property <bool> notice-is-error: false;
    in property <string> notice-text: "";
    in property <string> notice-action-text: "";
    callback notice-action();
    callback notice-dismiss();
    in-out property <bool> has-image: false;
    in-out property <int> image-pixel-width: 1;
    in-out property <int> image-pixel-height: 1;
    in-out property <bool> current-file-deleted: false;
    in-out property <bool> current-file-renamed: false;
    in-out property <bool> current-file-new: false;
    in-out property <bool> current-file-modified: false;
    in-out property <bool> is-ctrl-pressed: false;
    in-out property <bool> is-shift-pressed: false;
    in-out property <int> current-rating: 0;
    in-out property <bool> is-multi-selection: false;
    in-out property <[MultiSelectTileData]> multi-selection-tiles: [];
    in-out property <string> current-file-badge-text: "";
    in-out property <string> canvas-empty-text: "No Image Loaded — Click 'Open Folder...' or select a Recent Folder";

    // Eyedropper HUD (Right-click hold)
    in-out property <bool> eyedropper-visible: false;
    in-out property <length> eyedropper-x: 0px;
    in-out property <length> eyedropper-y: 0px;
    in-out property <color> eyedropper-color: #000000;
    in-out property <string> eyedropper-xy-text: "XY: (0, 0)";
    in-out property <string> eyedropper-rgb-text: "RGB:   0,   0,   0";
    in-out property <string> eyedropper-hsl-text: "HSL:   0°,   0%,   0%";

    // Magnifier Loupe HUD (Middle-click / wheel hold, dynamic 4x current zoom)
    in-out property <bool> loupe-visible: false;
    in-out property <length> loupe-x: 0px;
    in-out property <length> loupe-y: 0px;
    in-out property <image> loupe-image;
    in-out property <string> loupe-badge-text: "4× (400%) [0, 0]";

    // Right Sidebar: Histogram & Metadata
    in-out property <image> histogram-image;
    in-out property <string> meta-embedded-icc: "Embedded ICC: None";
    in-out property <string> meta-active-icc: "Active Profile: —";
    in-out property <string> meta-display-icc: "Display Target: sRGB";
    in-out property <[MetadataRowData]> metadata-rows: [];

    // Status Bar
    in-out property <string> status-file-text: "Ready — Open a folder to view images";
    // Background work in progress (e.g. reading image sizes); empty when idle.
    in property <string> status-task-text: "";
    in-out property <string> status-eyedropper-text: "Eyedropper: R-Click | Loupe: M-Click";
    in-out property <string> status-cache-text: "RAM Cache: 0 / 0 (0.0 MB)";

    // --- Callbacks to Rust Backend ---
    callback open-files-clicked();
    callback open-folder-clicked();
    callback save-image-clicked();
    callback profile-selected(string);
    callback lock-profile-toggled(bool);
    callback lock-zoom-toggled(bool);
    callback zoom-in-clicked();
    callback zoom-out-clicked();
    callback zoom-100-clicked();
        callback zoom-fit-clicked(float, float);
    callback zoom-set-factor(float);
    property <bool> zoom-popup-open: false;
    in-out property <[ZoomPreset]> zoom-presets: [
        { label: "800%", factor: 8.0 },
        { label: "700%", factor: 7.0 },
        { label: "600%", factor: 6.0 },
        { label: "500%", factor: 5.0 },
        { label: "400%", factor: 4.0 },
        { label: "300%", factor: 3.0 },
        { label: "200%", factor: 2.0 },
        { label: "100%", factor: 1.0 },
        { label: "75%", factor: 0.75 },
        { label: "50%", factor: 0.50 },
        { label: "25%", factor: 0.25 },
        { label: "10%", factor: 0.10 }
    ];
    callback prev-image-clicked();
    callback next-image-clicked();
    callback tree-item-clicked(string);
    callback tree-item-toggle-expand(string);
    in-out property <bool> current-image-is-cropped: false;
    callback undo-action();
    callback redo-action();
    callback jump-forward-10();
    callback jump-backward-10();
    callback cycle-profile();
    callback rotate-cw();
    callback rotate-ccw();
    callback recent-folder-clicked(string);
    callback recent-folder-remove(string);
    callback recent-folders-clear();
    callback filmstrip-item-clicked(int, bool, bool);
    callback open-containing-folder-explorer(string);
    callback rate-selected-images(int);
    callback rate-filmstrip-item(int, int);
    callback delete-selected-images();
    callback multi-select-tile-clicked(string);
    callback request-rename();
    callback confirm-rename(string);
    callback refresh-current-folder();
    callback request-open-with-apps(string);
    callback open-with-app-clicked(int, string);
    callback open-with-dialog-clicked(string);

    // Canvas interaction callbacks (viewport_x, viewport_y, viewport_w, viewport_h)
    callback canvas-wheel(float, float, float, float, float);
    callback canvas-pan(float, float);
    callback canvas-inspect-pixel(float, float, float, float);
    callback canvas-inspect-loupe(float, float, float, float);

    in-out property <length> filmstrip-offset-x: 0px;

    public function scroll-filmstrip(delta-y: length, delta-x: length) {
        let eff-delta = (delta-x != 0px) ? delta-x : delta-y;
        let step = eff-delta * 1.8;
        let total-w = (root.filmstrip-items.length * 162 + 12) * 1px;
        let min-x = min(0px, filmstrip-container.width - total-w);
        root.filmstrip-offset-x = max(min-x, min(0px, root.filmstrip-offset-x + step));
    }

    public function ensure-filmstrip-item-visible(index: int) {
        let total-w = (root.filmstrip-items.length * 162 + 12) * 1px;
        let item-left = (index * 162 + 6) * 1px;
        let item-right = item-left + 162px;
        let view-left = -root.filmstrip-offset-x;
        let view-right = view-left + filmstrip-container.width;

        if (item-left < view-left) {
            root.filmstrip-offset-x = min(0px, -item-left + 12px);
        } else if (item-right > view-right) {
            let min-x = min(0px, filmstrip-container.width - total-w);
            root.filmstrip-offset-x = max(min-x, -(item-right - filmstrip-container.width + 12px));
        }
    }

    // Context menu state for Recent Folders & Color Profile Dropdown
    property <bool> context-menu-visible: false;
    property <length> context-menu-x: 0px;
    property <length> context-menu-y: 0px;
    property <string> context-menu-target-path: "";
    property <string> context-menu-target-name: "";
    property <bool> profile-dropdown-open: false;
    property <bool> film-menu-visible: false;
    property <length> film-menu-x: 0px;
    property <length> film-menu-y: 0px;
    property <string> film-menu-target-path: "";
    property <string> film-menu-target-name: "";
    in-out property <int> selected-files-count: 0;
    in-out property <bool> rename-dialog-visible: false;
    in-out property <int> rename-file-count: 1;
    in-out property <string> rename-input-text: "";
    in-out property <string> rename-extension-text: "";
    in-out property <string> rename-error-text: "";
    in-out property <[OpenWithAppItem]> open-with-apps: [];
    in-out property <bool> open-with-submenu-visible: false;

    // Crop Tool (Taglierina) properties & callbacks
    in-out property <bool> crop-active: false;
    in-out property <string> crop-aspect-label: "Unconstrained";
    in-out property <float> crop-aspect-ratio: 0.0;
    in-out property <bool> crop-aspect-menu-open: false;
    in-out property <bool> crop-custom-dialog-visible: false;
    in-out property <string> crop-custom-input: "16x9";

    in-out property <float> crop-norm-x: 0.05;
    in-out property <float> crop-norm-y: 0.05;
    in-out property <float> crop-norm-w: 0.90;
    in-out property <float> crop-norm-h: 0.90;

    callback apply-crop();
    callback apply-custom-aspect-ratio(string);

    public function init-crop-box() {
        if (root.crop-aspect-ratio > 0.0) {
            root.adjust-crop-ratio();
        } else {
            root.crop-norm-x = 0.05;
            root.crop-norm-y = 0.05;
            root.crop-norm-w = 0.90;
            root.crop-norm-h = 0.90;
        }
    }

    public function adjust-crop-ratio() {
        if (root.crop-aspect-ratio <= 0.0) { return; }
        let r_norm = root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width));
        if (r_norm <= 1.0) {
            root.crop-norm-h = 0.85;
            root.crop-norm-w = max(0.05, min(0.95, 0.85 * r_norm));
        } else {
            root.crop-norm-w = 0.85;
            root.crop-norm-h = max(0.05, min(0.95, 0.85 / r_norm));
        }
        root.crop-norm-x = (1.0 - root.crop-norm-w) / 2.0;
        root.crop-norm-y = (1.0 - root.crop-norm-h) / 2.0;
    }

    public function set-aspect-ratio(label: string, ratio: float) {
        root.crop-aspect-label = label;
        if (ratio == -1.0) {
            root.crop-aspect-ratio = (root.image-pixel-width * 1.0) / max(1.0, root.image-pixel-height * 1.0);
        } else {
            root.crop-aspect-ratio = ratio;
        }
        root.crop-aspect-menu-open = false;
        root.crop-active = true;
        root.adjust-crop-ratio();
    }

    public function toggle-crop-mode() {
        root.crop-aspect-menu-open = false;
        root.crop-active = !root.crop-active;
        if (root.crop-active) {
            root.init-crop-box();
        }
    }

    public function switch-crop-orientation() {
        if (root.crop-aspect-ratio > 0.0) {
            let inv = 1.0 / root.crop-aspect-ratio;
            root.crop-aspect-ratio = inv;
            let parts = root.crop-aspect-label;
            root.crop-aspect-label = parts + " ⇄";
            root.adjust-crop-ratio();
        } else {
            let temp_w = root.crop-norm-w;
            let temp_h = root.crop-norm-h;
            root.crop-norm-w = min(1.0 - root.crop-norm-x, temp_h);
            root.crop-norm-h = min(1.0 - root.crop-norm-y, temp_w);
            root.crop-norm-x = (1.0 - root.crop-norm-w) / 2.0;
            root.crop-norm-y = (1.0 - root.crop-norm-h) / 2.0;
        }
        root.crop-aspect-menu-open = false;
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
        key-handler.focus();
    }

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            root.is-ctrl-pressed = event.modifiers.control;
            root.is-shift-pressed = event.modifiers.shift;

            if (root.crop-custom-dialog-visible) {
                if (event.text == Key.Escape) {
                    root.crop-custom-dialog-visible = false;
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.apply-custom-aspect-ratio(root.crop-custom-input);
                    return accept;
                }
                return reject;
            }

            if (root.rename-dialog-visible) {
                if (event.text == Key.Escape) {
                    root.rename-dialog-visible = false;
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.confirm-rename(root.rename-input-text);
                    return accept;
                }
                return reject;
            }

            if (root.shortcuts-dialog-visible || root.about-dialog-visible || root.exit-confirm-dialog-visible) {
                if (event.text == Key.Escape) {
                    root.shortcuts-dialog-visible = false;
                    root.about-dialog-visible = false;
                    root.exit-confirm-dialog-visible = false;
                    return accept;
                }
                return reject;
            }

            // Crop tool keyboard shortcuts: Enter applies crop, Esc cancels crop mode
            if (root.crop-active) {
                if (event.text == Key.Return) {
                    root.apply-crop();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.crop-active = false;
                    return accept;
                }
            }

            // Close dialogs and open menus on Escape (Tasks 7, 10)
            if (event.text == Key.Escape) {
                if (root.shortcuts-dialog-visible) {
                    root.shortcuts-dialog-visible = false;
                    return accept;
                }
                if (root.about-dialog-visible) {
                    root.about-dialog-visible = false;
                    return accept;
                }
                if (root.exit-confirm-dialog-visible) {
                    root.exit-confirm-dialog-visible = false;
                    return accept;
                }
                if (root.file-menu-open || root.edit-menu-open || root.view-menu-open || root.help-menu-open || root.crop-aspect-menu-open || root.profile-dropdown-open || root.zoom-popup-open) {
                    root.file-menu-open = false;
                    root.edit-menu-open = false;
                    root.view-menu-open = false;
                    root.help-menu-open = false;
                    root.crop-aspect-menu-open = false;
                    root.profile-dropdown-open = false;
                    root.zoom-popup-open = false;
                    return accept;
                }
            }

            // Customizable shortcut lookup via Rust
            let pressed_combo = root.key-to-string(event.text, event.modifiers.control, event.modifiers.shift);
            let action = root.get-action-for-shortcut(pressed_combo);
            if (action == "undo") { root.undo-action(); return accept; }
            if (action == "redo") { root.redo-action(); return accept; }
            if (action == "toggle_crop") { root.toggle-crop-mode(); return accept; }
            if (action == "jump_forward_10") { root.jump-forward-10(); return accept; }
            if (action == "jump_backward_10") { root.jump-backward-10(); return accept; }
            if (action == "cycle_profile") { root.cycle-profile(); return accept; }
            if (action == "open_shortcuts") { root.open-shortcuts-dialog(); return accept; }
            if (action == "zoom_in") { root.zoom-in-clicked(); return accept; }
            if (action == "zoom_out") { root.zoom-out-clicked(); return accept; }
            if (action == "zoom_fit") { root.zoom-fit-clicked(canvas-area.width / 1px, canvas-area.height / 1px); return accept; }
            if (action == "zoom_100") { root.zoom-100-clicked(); return accept; }
            if (action == "rotate_cw") { root.rotate-cw(); return accept; }
            if (action == "rotate_ccw") { root.rotate-ccw(); return accept; }
            if (action == "next_image") { root.next-image-clicked(); return accept; }
            if (action == "prev_image") { root.prev-image-clicked(); return accept; }
            if (action == "rename") { root.request-rename(); return accept; }
            if (action == "delete") { root.delete-selected-images(); return accept; }
            if (action == "refresh") { root.refresh-current-folder(); return accept; }
            if (action == "open_file") { root.open-files-clicked(); return accept; }
            if (action == "open_folder") { root.open-folder-clicked(); return accept; }
            if (action == "save") { root.save-image-clicked(); return accept; }

            // Rating keys 0-5 (when no modifier is pressed)
            if (!event.modifiers.control && !event.modifiers.shift) {
                if (event.text == "1") { root.rate-selected-images(1); return accept; }
                if (event.text == "2") { root.rate-selected-images(2); return accept; }
                if (event.text == "3") { root.rate-selected-images(3); return accept; }
                if (event.text == "4") { root.rate-selected-images(4); return accept; }
                if (event.text == "5") { root.rate-selected-images(5); return accept; }
                if (event.text == "0") { root.rate-selected-images(0); return accept; }
            }
            return reject;
        }

        key-released(event) => {
            root.is-ctrl-pressed = event.modifiers.control;
            root.is-shift-pressed = event.modifiers.shift;
            return reject;
        }

        VerticalLayout {
            // Classic Desktop Menubar (File | Modifica | Visualizza | ?)
            menubar := Rectangle {
                height: 28px;
                background: #1C1C1C;
                border-width: 1px;
                border-color: #262626;

                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 2px;
                    alignment: start;

                    // "File" Menu
                    file-menu-btn := Rectangle {
                        background: (file-touch.has-hover || root.file-menu-open) ? #333333 : transparent;
                        border-radius: 2px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "File";
                                color: (file-touch.has-hover || root.file-menu-open) ? #FFFFFF : #D0D0D0;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        file-touch := TouchArea {
                            clicked => {
                                let was_open = root.file-menu-open;
                                root.edit-menu-open = false;
                                root.view-menu-open = false;
                                root.help-menu-open = false;
                                root.file-menu-open = !was_open;
                            }
                            changed has-hover => {
                                if (self.has-hover && (root.edit-menu-open || root.view-menu-open || root.help-menu-open)) {
                                    root.edit-menu-open = false;
                                    root.view-menu-open = false;
                                    root.help-menu-open = false;
                                    root.file-menu-open = true;
                                }
                            }
                        }
                    }

                    // "Edit" Menu
                    edit-menu-btn := Rectangle {
                        background: (edit-touch.has-hover || root.edit-menu-open) ? #333333 : transparent;
                        border-radius: 2px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Edit";
                                color: (edit-touch.has-hover || root.edit-menu-open) ? #FFFFFF : #D0D0D0;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        edit-touch := TouchArea {
                            clicked => {
                                let was_open = root.edit-menu-open;
                                root.file-menu-open = false;
                                root.view-menu-open = false;
                                root.help-menu-open = false;
                                root.edit-menu-open = !was_open;
                            }
                            changed has-hover => {
                                if (self.has-hover && (root.file-menu-open || root.view-menu-open || root.help-menu-open)) {
                                    root.file-menu-open = false;
                                    root.view-menu-open = false;
                                    root.help-menu-open = false;
                                    root.edit-menu-open = true;
                                }
                            }
                        }
                    }

                    // "View" Menu
                    view-menu-btn := Rectangle {
                        background: (view-touch.has-hover || root.view-menu-open) ? #333333 : transparent;
                        border-radius: 2px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "View";
                                color: (view-touch.has-hover || root.view-menu-open) ? #FFFFFF : #D0D0D0;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        view-touch := TouchArea {
                            clicked => {
                                let was_open = root.view-menu-open;
                                root.file-menu-open = false;
                                root.edit-menu-open = false;
                                root.help-menu-open = false;
                                root.view-menu-open = !was_open;
                            }
                            changed has-hover => {
                                if (self.has-hover && (root.file-menu-open || root.edit-menu-open || root.help-menu-open)) {
                                    root.file-menu-open = false;
                                    root.edit-menu-open = false;
                                    root.help-menu-open = false;
                                    root.view-menu-open = true;
                                }
                            }
                        }
                    }

                    // "Help" Menu
                    help-menu-btn := Rectangle {
                        background: (help-touch.has-hover || root.help-menu-open) ? #333333 : transparent;
                        border-radius: 2px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Help";
                                color: (help-touch.has-hover || root.help-menu-open) ? #FFFFFF : #D0D0D0;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                        help-touch := TouchArea {
                            clicked => {
                                let was_open = root.help-menu-open;
                                root.file-menu-open = false;
                                root.edit-menu-open = false;
                                root.view-menu-open = false;
                                root.help-menu-open = !was_open;
                            }
                            changed has-hover => {
                                if (self.has-hover && (root.file-menu-open || root.edit-menu-open || root.view-menu-open)) {
                                    root.file-menu-open = false;
                                    root.edit-menu-open = false;
                                    root.view-menu-open = false;
                                    root.help-menu-open = true;
                                }
                            }
                        }
                    }
                }
            }

            // Top Control Toolbar
            Rectangle {
                height: 44px;
                background: #202020;
                border-width: 1px;
                border-color: #2A2A2A;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;
                    alignment: start;

                    Win10Button {
                        text: "Undo";
                        has-icon: true;
                        icon: @image-url("../assets/icons/undo.svg");
                        clicked => { root.undo-action(); }
                    }

                    Win10Button {
                        text: "Redo";
                        has-icon: true;
                        icon: @image-url("../assets/icons/redo.svg");
                        clicked => { root.redo-action(); }
                    }

                    Rectangle { width: 1px; background: #2C2C2C; }

                    Win10Button {
                        text: "Rotate Left";
                        has-icon: true;
                        icon: @image-url("../assets/icons/rotate_left.svg");
                        clicked => { root.rotate-ccw(); }
                    }

                    Win10Button {
                        text: "Rotate Right";
                        has-icon: true;
                        icon: @image-url("../assets/icons/rotate_right.svg");
                        clicked => { root.rotate-cw(); }
                    }

                    Rectangle { width: 1px; background: #2C2C2C; }

                    // Crop Tool Button (Task 9)
                    crop-btn := Rectangle {
                        height: 30px;
                        horizontal-stretch: 0;
                        background: root.crop-active ? #005A9E : (crop-touch.has-hover ? #303030 : #242424);
                        border-width: 1px;
                        border-color: root.crop-active ? #0078D7 : (crop-touch.has-hover ? #444444 : #383838);
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Image {
                                source: @image-url("../assets/icons/crop.svg");
                                width: 15px;
                                height: 15px;
                                image-fit: contain;
                                colorize: root.crop-active ? #FFFFFF : (crop-touch.has-hover ? #FFFFFF : #B0B0B0);
                                y: (parent.height - self.height) / 2.0;
                            }
                            Text {
                                text: "Crop";
                                color: root.crop-active ? #FFFFFF : (crop-touch.has-hover ? #E2E2E2 : #B0B0B0);
                                font-size: 12px;
                                font-weight: root.crop-active ? 600 : 500;
                                vertical-alignment: center;
                            }
                        }
                        crop-touch := TouchArea {
                            clicked => {
                                root.toggle-crop-mode();
                            }
                        }
                    }

                    // Aspect Ratio Dropdown Button (immediately right of Crop button)
                    aspect-btn := Rectangle {
                        height: 30px;
                        horizontal-stretch: 0;
                        background: root.crop-aspect-menu-open ? #2E2E2E : (aspect-touch.has-hover ? #2A2A2A : #1C1C1C);
                        border-width: 1px;
                        border-color: root.crop-aspect-menu-open ? #5A5A5A : (aspect-touch.has-hover ? #444444 : #343434);
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: root.crop-aspect-label;
                                color: #CCCCCC;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            ChevronDown {
                                stroke: #9E9E9E;
                                y: (parent.height - self.height) / 2.0;
                            }
                        }
                        aspect-touch := TouchArea {
                            clicked => {
                                root.file-menu-open = false;
                                root.edit-menu-open = false;
                                root.view-menu-open = false;
                                root.help-menu-open = false;
                                root.profile-dropdown-open = false;
                                root.zoom-popup-open = false;
                                root.crop-aspect-menu-open = !root.crop-aspect-menu-open;
                            }
                        }
                    }

                    Rectangle { width: 1px; background: #2C2C2C; }

                    Text {
                        text: "Color Profile:";
                        color: #949494;
                        font-weight: 600;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    // Custom Native Color Profile Selector
                    profile-box := Rectangle {
                        height: 30px;
                        horizontal-stretch: 0;
                        background: root.profile-dropdown-open ? #2E2E2E : (prof-touch.has-hover ? #2A2A2A : #1C1C1C);
                        border-width: 1px;
                        border-color: root.profile-dropdown-open ? #5A5A5A : (prof-touch.has-hover ? #444444 : #343434);
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: root.current-profile;
                                color: #BCBCBC;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            ChevronDown {
                                stroke: root.profile-dropdown-open ? #CCCCCC : #888888;
                                y: (parent.height - self.height) / 2.0;
                            }
                        }

                        prof-touch := TouchArea {
                            clicked => {
                                root.context-menu-visible = false;
                                root.profile-dropdown-open = !root.profile-dropdown-open;
                            }
                        }
                    }

                    // Embedded ICC Status Badge
                    Rectangle {
                        height: 30px;
                        horizontal-stretch: 0;
                        background: root.has-image ? (root.has-embedded-icc ? #1A2E20 : #2C2616) : #242424;
                        border-width: 1px;
                        border-color: root.has-image ? (root.has-embedded-icc ? #254B32 : #483A1F) : #333333;
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: root.embedded-badge-text;
                                color: root.has-image ? (root.has-embedded-icc ? #5CBD50 : #D9C324) : #888888;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Win10CheckBox {
                        text: "Lock Color Profile";
                        checked <=> root.lock-profile;
                        toggled(val) => {
                            root.lock-profile-toggled(val);
                        }
                    }

                    Win10CheckBox {
                        text: "Lock Zoom";
                        checked <=> root.lock-zoom;
                        toggled(val) => {
                            root.lock-zoom-toggled(val);
                        }
                    }

                    Rectangle { width: 1px; background: #2C2C2C; }

                    // Photos / Studio Style Zoom Control Bar
                    Rectangle {
                        height: 30px;
                        horizontal-stretch: 0;
                        background: #1C1C1C;
                        border-width: 1px;
                        border-color: #343434;
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;

                            // Fit to screen button
                            Rectangle {
                                width: 26px;
                                height: 24px;
                                background: fit-touch.has-hover ? #2A2A2A : transparent;
                                border-radius: 2px;
                                Image {
                                    source: @image-url("../assets/icons/expand.svg");
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                    colorize: fit-touch.has-hover ? #FFFFFF : #B0B0B0;
                                    x: (parent.width - self.width) / 2.0;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                fit-touch := TouchArea {
                                    clicked => {
                                        root.zoom-popup-open = false;
                                        root.zoom-fit-clicked(canvas-area.width / 1px, canvas-area.height / 1px);
                                    }
                                }
                            }

                            // 1:1 Actual Size (100%) Button
                            Rectangle {
                                height: 24px;
                                background: z11-touch.has-hover ? #2A2A2A : transparent;
                                border-radius: 2px;
                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    alignment: center;
                                    Text {
                                        text: "1:1";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: z11-touch.has-hover ? #FFFFFF : #B0B0B0;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                z11-touch := TouchArea {
                                    clicked => {
                                        root.zoom-popup-open = false;
                                        root.zoom-100-clicked();
                                    }
                                }
                            }

                            Rectangle { width: 1px; height: 16px; background: #2E2E2E; }

                            // Zoom percentage button with dropdown arrow: "48% ⌵"
                            zoom-btn := Rectangle {
                                height: 24px;
                                background: root.zoom-popup-open ? #2A2A2A : (pct-touch.has-hover ? #262626 : transparent);
                                border-radius: 2px;
                                border-width: 1px;
                                border-color: root.zoom-popup-open ? #555555 : transparent;

                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: root.zoom-text;
                                        color: pct-touch.has-hover ? #E2E2E2 : #B0B0B0;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    ChevronDown {
                                        stroke: root.zoom-popup-open ? #CCCCCC : #888888;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }

                                pct-touch := TouchArea {
                                    clicked => {
                                        root.context-menu-visible = false;
                                        root.film-menu-visible = false;
                                        root.profile-dropdown-open = false;
                                        root.zoom-popup-open = !root.zoom-popup-open;
                                    }
                                }
                            }

                            Rectangle { width: 1px; height: 16px; background: #2E2E2E; }

                            // Magnifier minus icon button
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: zm-touch.has-hover ? #2A2A2A : transparent;
                                border-radius: 2px;
                                C1ZoomMinusIcon {
                                    stroke: zm-touch.has-hover ? #FFFFFF : #B0B0B0;
                                    x: (parent.width - self.width) / 2.0;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                zm-touch := TouchArea {
                                    clicked => { root.zoom-out-clicked(); }
                                }
                            }

                            // Interactive Zoom Slider
                            zoom-slider := Rectangle {
                                width: 100px;
                                height: 24px;
                                background: transparent;

                                property <float> ratio: root.zoom-factor <= 1.0 
                                    ? max(0.0, min(0.5, (root.zoom-factor - 0.10) / 0.90 * 0.5)) 
                                    : min(1.0, 0.5 + (root.zoom-factor - 1.0) / 7.0 * 0.5);

                                // Background track line
                                Rectangle {
                                    x: 4px;
                                    y: (parent.height - 3px) / 2.0;
                                    width: parent.width - 8px;
                                    height: 3px;
                                    background: #333333;
                                    border-radius: 1.5px;
                                }

                                // Filled track line
                                Rectangle {
                                    x: 4px;
                                    y: (parent.height - 3px) / 2.0;
                                    width: max(0px, (parent.width - 8px) * zoom-slider.ratio);
                                    height: 3px;
                                    background: #666666;
                                    border-radius: 1.5px;
                                }

                                // Draggable circular thumb knob
                                Rectangle {
                                    x: 4px + (parent.width - 18px) * zoom-slider.ratio;
                                    y: (parent.height - 12px) / 2.0;
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: slider-touch.has-hover || slider-touch.pressed ? #D4D4D4 : #A0A0A0;
                                    border-width: 1px;
                                    border-color: #555555;
                                }

                                slider-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down || (ev.kind == PointerEventKind.move && self.pressed)) {
                                            let track-w = parent.width - 8px;
                                            let click-ratio = max(0.0, min(1.0, (self.mouse-x - 4px) / track-w));
                                            let new-zoom = click-ratio <= 0.5 
                                                ? (0.10 + (click-ratio / 0.5) * 0.90) 
                                                : (1.0 + ((click-ratio - 0.5) / 0.5) * 7.0);
                                            root.zoom-set-factor(new-zoom);
                                        }
                                    }
                                }
                            }

                            // Magnifier plus icon button
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: zp-touch.has-hover ? #2A2A2A : transparent;
                                border-radius: 2px;
                                C1ZoomPlusIcon {
                                    stroke: zp-touch.has-hover ? #FFFFFF : #B0B0B0;
                                    x: (parent.width - self.width) / 2.0;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                zp-touch := TouchArea {
                                    clicked => { root.zoom-in-clicked(); }
                                }
                            }
                        }
                    }
                }
            }



            // Main 3-Column Workspace: Left Sidebar | Center (Canvas + Filmstrip) | Right Sidebar (Histogram & Metadata)
            HorizontalLayout {
                vertical-stretch: 1;

                // --- LEFT SIDEBAR (Folder Tree + Recent 10 Folders) ---
                if root.left-panel-visible : Rectangle {
                    width: root.left-panel-width;
                    background: #202020;
                    border-width: 1px;
                    border-color: #1C1C1C;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 6px;

                        // --- FILTERS & SEARCH (Tasks 2, 3, 4, 5, 7, 21) ---
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "FILTERS & SEARCH";
                                    color: #D0D0D0;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if (root.filter-search-text != "" || root.has-active-rating-filter() || root.filter-aspect-ratio != "ALL" || root.filter-color-profile != "ALL" || root.filter-is-cropped || root.filter-is-profile-modified) : Rectangle {
                                    width: 86px;
                                    height: 22px;
                                    background: clr-flt-t.has-hover ? #444444 : #2E2E2E;
                                    border-radius: 3px;
                                    Text {
                                        text: "Reset filters";
                                        color: #E8E8E8;
                                        font-size: 11px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    clr-flt-t := TouchArea {
                                        clicked => {
                                            root.filter-search-text = "";
                                            root.clear-ratings();
                                            root.filter-aspect-ratio = "ALL";
                                            root.filter-color-profile = "ALL";
                                            root.filter-is-cropped = false;
                                            root.filter-is-profile-modified = false;
                                            root.filter-clear-clicked();
                                        }
                                    }
                                }
                            }

                            // Search Box (Task 18: Name + Extension)
                            Rectangle {
                                height: 28px;
                                background: #161616;
                                border-width: 1px;
                                border-color: search-input.has-focus ? #007ACC : #383838;
                                border-radius: 3px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Image {
                                        source: @image-url("../assets/icons/search.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: #AAAAAA;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                    search-input := TextInput {
                                        text <=> root.filter-search-text;
                                        color: #FFFFFF;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        edited => {
                                            root.trigger-filter-update();
                                        }
                                    }
                                }
                            }

                            // Modification Status Filters (Task 21)
                            VerticalLayout {
                                spacing: 4px;
                                Win10CheckBox {
                                    text: "Cropped Image";
                                    checked <=> root.filter-is-cropped;
                                    toggled(val) => { root.trigger-filter-update(); }
                                }
                                Win10CheckBox {
                                    text: "Modified Profile";
                                    checked <=> root.filter-is-profile-modified;
                                    toggled(val) => { root.trigger-filter-update(); }
                                }
                            }

                            // Star Exact Multi-Rating Filter Row (Task 4)
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Rating (Multi-Select):"; font-size: 12px; color: #A0A0A0; font-weight: 500; }
                                }
                                HorizontalLayout {
                                    spacing: 3px;
                                    height: 24px;
                                    // All
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: (!root.has-active-rating-filter()) ? #007ACC : (rall-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "All"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        rall-t := TouchArea { clicked => { root.clear-ratings(); root.trigger-filter-update(); } }
                                    }
                                    // 0★
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.filter-r0 ? #007ACC : (r0-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "0★"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        r0-t := TouchArea { clicked => { root.filter-r0 = !root.filter-r0; root.trigger-filter-update(); } }
                                    }
                                    // 1★
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.filter-r1 ? #007ACC : (r1-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "1★"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        r1-t := TouchArea { clicked => { root.filter-r1 = !root.filter-r1; root.trigger-filter-update(); } }
                                    }
                                    // 2★
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.filter-r2 ? #007ACC : (r2-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "2★"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        r2-t := TouchArea { clicked => { root.filter-r2 = !root.filter-r2; root.trigger-filter-update(); } }
                                    }
                                    // 3★
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.filter-r3 ? #007ACC : (r3-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "3★"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        r3-t := TouchArea { clicked => { root.filter-r3 = !root.filter-r3; root.trigger-filter-update(); } }
                                    }
                                    // 4★
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.filter-r4 ? #007ACC : (r4-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "4★"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        r4-t := TouchArea { clicked => { root.filter-r4 = !root.filter-r4; root.trigger-filter-update(); } }
                                    }
                                    // 5★
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: root.filter-r5 ? #007ACC : (r5-t.has-hover ? #303030 : #1C1C1C);
                                        border-radius: 3px;
                                        Text { text: "5★"; font-size: 11px; font-weight: 600; color: #FFFFFF; horizontal-alignment: center; vertical-alignment: center; }
                                        r5-t := TouchArea { clicked => { root.filter-r5 = !root.filter-r5; root.trigger-filter-update(); } }
                                    }
                                }
                            }

                            // Color Profile Filter (Task 2: remove Embedded Profile, add None)
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Color Profile Filter:"; font-size: 12px; color: #A0A0A0; font-weight: 500; }
                                Rectangle {
                                    height: 28px;
                                    background: f-cp-t.has-hover ? #2A2A2A : #1C1C1C;
                                    border-width: 1px;
                                    border-color: root.filter-profile-menu-open ? #5A5A5A : #383838;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.filter-color-profile == "ALL" ? "All Profiles" : (root.filter-color-profile == "NONE" ? "None (Untagged)" : root.filter-color-profile);
                                            color: #FFFFFF;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.filter-profile-menu-open ? "▲" : "▼";
                                            color: #AAAAAA;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    f-cp-t := TouchArea {
                                        clicked => {
                                            root.filter-profile-menu-open = !root.filter-profile-menu-open;
                                            root.filter-aspect-menu-open = false;
                                        }
                                    }
                                }
                                if root.filter-profile-menu-open : Rectangle {
                                    background: #252526;
                                    border-width: 1px;
                                    border-color: #404040;
                                    border-radius: 3px;
                                    VerticalLayout {
                                        padding: 2px;
                                        spacing: 1px;
                                        for prof in [
                                            "ALL",
                                            "NONE",
                                            "sRGB IEC61966-2.1",
                                            "Adobe RGB (1998)",
                                            "ProPhoto RGB (ROMM RGB)",
                                            "Display P3",
                                            "Rec.2020",
                                            "Rec.709",
                                            "Wide Gamut RGB",
                                            "Apple RGB"
                                        ] : Rectangle {
                                            height: 24px;
                                            background: f-p-it.has-hover ? #383838 : (root.filter-color-profile == prof ? #303030 : transparent);
                                            border-radius: 2px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                Text {
                                                    text: (root.filter-color-profile == prof) ? "✓" : " ";
                                                    width: 12px;
                                                    color: #5CBD50;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: prof == "ALL" ? "All Profiles" : (prof == "NONE" ? "None (Untagged)" : prof);
                                                    color: #F0F0F0;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            f-p-it := TouchArea {
                                                clicked => {
                                                    root.filter-color-profile = prof;
                                                    root.filter-profile-menu-open = false;
                                                    root.trigger-filter-update();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Aspect Ratio Filter (Tasks 3, 5, 7)
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Aspect Ratio Filter:"; font-size: 12px; color: #A0A0A0; font-weight: 500; }
                                Rectangle {
                                    height: 28px;
                                    background: f-ar-t.has-hover ? #2A2A2A : #1C1C1C;
                                    border-width: 1px;
                                    border-color: root.filter-aspect-menu-open ? #5A5A5A : #383838;
                                    border-radius: 3px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.filter-aspect-ratio == "ALL" ? "All Aspect Ratios" : (root.filter-aspect-ratio == "OTHER" ? "Other aspect ratio" : root.filter-aspect-ratio);
                                            color: #FFFFFF;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.filter-aspect-menu-open ? "▲" : "▼";
                                            color: #AAAAAA;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    f-ar-t := TouchArea {
                                        clicked => {
                                            root.filter-aspect-menu-open = !root.filter-aspect-menu-open;
                                            root.filter-profile-menu-open = false;
                                        }
                                    }
                                }
                                if root.filter-aspect-menu-open : Rectangle {
                                    background: #252526;
                                    border-width: 1px;
                                    border-color: #404040;
                                    border-radius: 3px;
                                    VerticalLayout {
                                        padding: 2px;
                                        spacing: 1px;
                                        for ar in [
                                            "ALL",
                                            "1x1",
                                            "3x2",
                                            "4x3",
                                            "5x4",
                                            "16x9",
                                            "21x9",
                                            "65x24"
                                        ] : Rectangle {
                                            height: 24px;
                                            background: f-ar-it.has-hover ? #383838 : (root.filter-aspect-ratio == ar ? #303030 : transparent);
                                            border-radius: 2px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                Text {
                                                    text: (root.filter-aspect-ratio == ar) ? "✓" : " ";
                                                    width: 12px;
                                                    color: #5CBD50;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: ar == "ALL" ? "All Aspect Ratios" : ar;
                                                    color: #F0F0F0;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            f-ar-it := TouchArea {
                                                clicked => {
                                                    root.filter-aspect-ratio = ar;
                                                    root.filter-aspect-menu-open = false;
                                                    root.trigger-filter-update();
                                                }
                                            }
                                        }

                                        // Saved custom aspect ratios in filter
                                        for custom_ar in root.saved-custom-aspect-ratios : Rectangle {
                                            height: 24px;
                                            background: f-car-it.has-hover ? #383838 : (root.filter-aspect-ratio == custom_ar ? #303030 : transparent);
                                            border-radius: 2px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                Text {
                                                    text: (root.filter-aspect-ratio == custom_ar) ? "✓" : " ";
                                                    width: 12px;
                                                    color: #5CBD50;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: custom_ar;
                                                    color: #F0F0F0;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            f-car-it := TouchArea {
                                                clicked => {
                                                    root.filter-aspect-ratio = custom_ar;
                                                    root.filter-aspect-menu-open = false;
                                                    root.trigger-filter-update();
                                                }
                                            }
                                        }

                                        // Other aspect ratio (Task 7)
                                        Rectangle {
                                            height: 24px;
                                            background: f-oth-it.has-hover ? #383838 : (root.filter-aspect-ratio == "OTHER" ? #303030 : transparent);
                                            border-radius: 2px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                Text {
                                                    text: (root.filter-aspect-ratio == "OTHER") ? "✓" : " ";
                                                    width: 12px;
                                                    color: #5CBD50;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: "Other aspect ratio";
                                                    color: #F0F0F0;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            f-oth-it := TouchArea {
                                                clicked => {
                                                    root.filter-aspect-ratio = "OTHER";
                                                    root.filter-aspect-menu-open = false;
                                                    root.trigger-filter-update();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #282828; }

                        // Subfolder Tree (visible automatically when subfolders exist)
                        if root.has-subfolders : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 4px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "FOLDER TREE";
                                    color: #B0B0B0;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 22px;
                                    height: 20px;
                                    background: ref-tree-touch.has-hover ? #303030 : transparent;
                                    border-radius: 2px;
                                    Image {
                                        source: @image-url("../assets/icons/refresh.svg");
                                        width: 13px;
                                        height: 13px;
                                        image-fit: contain;
                                        colorize: ref-tree-touch.has-hover ? #FFFFFF : #A0A0A0;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                    ref-tree-touch := TouchArea {
                                        clicked => { root.refresh-current-folder(); }
                                    }
                                }
                            }

                            Rectangle {
                                background: #161616;
                                border-width: 1px;
                                border-color: #282828;
                                vertical-stretch: 1;

                                ScrollView {
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 1px;
                                        for item in root.folder-tree-items : Rectangle {
                                            height: 24px;
                                            background: item.selected ? #444444 : (tree-touch.has-hover ? #282828 : transparent);
                                            border-radius: 3px;

                                            HorizontalLayout {
                                                padding-left: (6 + item.depth * 14) * 1px;
                                                padding-right: 6px;
                                                spacing: 6px;
                                                alignment: start;

                                                // Expand/collapse chevron area with dedicated TouchArea
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    y: (parent.height - self.height) / 2;

                                                    if item.has_children && item.is_expanded : ChevronDown {
                                                        stroke: item.selected ? #FFFFFF : #A0A0A0;
                                                        x: (parent.width - self.width) / 2.0;
                                                        y: (parent.height - self.height) / 2.0;
                                                    }
                                                    if item.has_children && !item.is_expanded : ChevronRight {
                                                        stroke: item.selected ? #FFFFFF : #A0A0A0;
                                                        x: (parent.width - self.width) / 2.0;
                                                        y: (parent.height - self.height) / 2.0;
                                                    }

                                                    if item.has_children : TouchArea {
                                                        clicked => {
                                                            root.tree-item-toggle-expand(item.path_key);
                                                        }
                                                    }
                                                }

                                                // Folder icon and Label with item selection TouchArea
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        if item.path_key != "__ROOT_ONLY__" : C1FolderIcon {
                                                            stroke: item.selected ? #FFFFFF : (item.depth == 0 ? #E3A83C : #B0B0B0);
                                                            y: (parent.height - self.height) / 2.0;
                                                        }
                                                        if item.path_key == "__ROOT_ONLY__" : Image {
                                                            source: @image-url("../assets/icons/file.svg");
                                                            width: 15px;
                                                            height: 15px;
                                                            image-fit: contain;
                                                            colorize: item.selected ? #FFFFFF : #B0B0B0;
                                                            y: (parent.height - self.height) / 2.0;
                                                        }

                                                        Text {
                                                            horizontal-stretch: 1;
                                                            text: item.label;
                                                            color: item.selected ? #FFFFFF : #CCCCCC;
                                                            font-size: 13px;
                                                            font-weight: item.selected ? 600 : 400;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }

                                                    tree-touch := TouchArea {
                                                        clicked => {
                                                            root.context-menu-visible = false;
                                                            root.tree-item-clicked(item.path_key);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Recent 10 Folders List
                        VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 4px;

                            HorizontalLayout {
                                Text {
                                    text: "RECENT FOLDERS";
                                    color: #B0B0B0;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Win10Button {
                                    text: "Clear";
                                    height: 22px;
                                    clicked => {
                                        root.context-menu-visible = false;
                                        root.recent-folders-clear();
                                    }
                                }
                            }

                            Rectangle {
                                background: #161616;
                                border-width: 1px;
                                border-color: #282828;
                                vertical-stretch: 1;

                                ScrollView {
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: 1px;
                                        for folder in root.recent-folders : Rectangle {
                                            height: 40px;
                                            background: folder.active ? #2D2D2D : (rec-touch.has-hover ? #262626 : transparent);
                                            border-width: 1px;
                                            border-color: folder.active ? #888888 : transparent;

                                            VerticalLayout {
                                                padding-left: 8px;
                                                padding-right: 6px;
                                                padding-top: 3px;
                                                padding-bottom: 3px;
                                                Text {
                                                    text: folder.name;
                                                    color: #C0C0C0;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: folder.parent_path;
                                                    color: #7E7E7E;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }

                                            rec-touch := TouchArea {
                                                clicked => {
                                                    root.context-menu-visible = false;
                                                    root.recent-folder-clicked(folder.full_path);
                                                }
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        root.context-menu-target-path = folder.full_path;
                                                        root.context-menu-target-name = folder.name;
                                                        root.context-menu-x = 18px;
                                                        root.context-menu-y = 140px;
                                                        root.context-menu-visible = true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "Right-click an item to remove or clear";
                                color: #888888;
                                font-size: 11px;
                            }
                        }
                    }
                }

                // Left Panel Resize Splitter (Task 3)
                if root.left-panel-visible : Rectangle {
                    width: 5px;
                    background: left-split.pressed || left-split.has-hover ? #007ACC : #1E1E1E;
                    left-split := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        property <length> start-w;
                        property <length> start-x;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                self.start-w = root.left-panel-width;
                                self.start-x = self.mouse-x;
                            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                let delta = self.mouse-x - self.start-x;
                                root.left-panel-width = max(160px, min(500px, self.start-w + delta));
                            }
                        }
                    }
                }

                // --- CENTER AREA (Interactive Image Canvas + Bottom Filmstrip) ---
                VerticalLayout {
                    horizontal-stretch: 1;

                    // Neutral #121212 Photographic Canvas
                    canvas-area := Rectangle {
                        vertical-stretch: 1;
                        background: #121212;
                        clip: true;

                        if !root.has-image && !root.is-multi-selection : Text {
                            text: root.canvas-empty-text;
                            color: #888888;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if root.has-image && !root.is-multi-selection : Image {
                            width: (root.image-pixel-width * root.view-zoom) * 1px;
                            height: (root.image-pixel-height * root.view-zoom) * 1px;
                            x: ((parent.width - self.width) / 2.0) + (root.pan-x * 1px);
                            y: ((parent.height - self.height) / 2.0) + (root.pan-y * 1px);
                            source: root.current-image;
                            image-rendering: root.zoom-factor >= 3.0 ? pixelated : smooth;
                        }

                        // Multi-selection 3x thumbnail comparison grid
                        if root.is-multi-selection : Rectangle {
                            width: 100%;
                            height: 100%;
                            background: #121212;

                            for tile in root.multi-selection-tiles : Rectangle {
                                x: tile.tile_x;
                                y: tile.tile_y;
                                width: tile.tile_w;
                                height: tile.tile_h;
                                background: #1E1E1E;
                                border-width: 1.5px;
                                border-color: #333337;
                                border-radius: 4px;
                                clip: true;

                                if tile.is_ellipsis : Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: #18181A;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;

                                        Text {
                                            text: "•••";
                                            color: #E0E0E0;
                                            font-size: 32px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: tile.ellipsis_text;
                                            color: #CCCCCC;
                                            font-size: 14px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                if !tile.is_ellipsis : VerticalLayout {
                                    padding: 6px;
                                    spacing: 6px;

                                    Rectangle {
                                        vertical-stretch: 1;
                                        background: #141414;
                                        border-width: 1px;
                                        border-color: #2D2D30;
                                        clip: true;

                                        if tile.has_thumbnail : Image {
                                            width: 100%;
                                            height: 100%;
                                            source: tile.thumbnail;
                                            image-fit: contain;
                                        }
                                        if !tile.has_thumbnail : Text {
                                            text: "Loading...";
                                            color: #777777;
                                            font-size: 13px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        HorizontalLayout {
                                            x: 6px;
                                            y: 6px;
                                            spacing: 4px;
                                            alignment: start;

                                            if tile.rating > 0 : Rectangle {
                                                height: 22px;
                                                background: #000000CC;
                                                border-width: 1px;
                                                border-color: #FFB900;
                                                border-radius: 3px;

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 3px;
                                                    Text {
                                                        text: "★";
                                                        color: #FFB900;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: tile.rating;
                                                        color: #FFFFFF;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if tile.is_cropped : Rectangle {
                                                height: 22px;
                                                background: #0078D7EE;
                                                border-width: 1px;
                                                border-color: #0098FF;
                                                border-radius: 3px;

                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 4px;
                                                    Image {
                                                        source: @image-url("../assets/icons/crop.svg");
                                                        width: 11px;
                                                        height: 11px;
                                                        colorize: #FFFFFF;
                                                        y: (parent.height - self.height) / 2.0;
                                                    }
                                                    Text {
                                                        text: "Crop";
                                                        color: #FFFFFF;
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        if tile.badge_text != "" : Rectangle {
                                            x: parent.width - self.width - 6px;
                                            y: parent.height - self.height - 6px;
                                            height: 22px;
                                            background: tile.badge_type == "deleted" ? #D83B01EE : (tile.badge_type == "renamed" ? #4A4A4AEE : (tile.badge_type == "modified" ? #D97706EE : #107C41EE));
                                            border-width: 1px;
                                            border-color: tile.badge_type == "deleted" ? #DE4848 : (tile.badge_type == "renamed" ? #888888 : (tile.badge_type == "modified" ? #E3A83C : #58B05C));
                                            border-radius: 3px;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: tile.badge_text;
                                                    color: #FFFFFF;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        height: 18px;
                                        text: tile.label;
                                        color: #F2F2F2;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                TouchArea {
                                    clicked => {
                                        if (!tile.is_ellipsis) {
                                            root.multi-select-tile-clicked(tile.full_path);
                                        }
                                    }
                                }
                            }
                        }

                        // Interactive Mouse Handler for Pan (Left), Eyedropper (Right Hold), Loupe (Middle Hold), Wheel Zoom
                        canvas-touch := TouchArea {
                            enabled: root.has-image && !root.is-multi-selection;
                            property <bool> is-panning: false;

                            double-clicked => {
                                root.canvas-double-clicked(
                                    self.mouse-x / 1px,
                                    self.mouse-y / 1px,
                                    parent.width / 1px,
                                    parent.height / 1px
                                );
                            }
                            property <bool> is-eyedropper: false;
                            property <bool> is-loupe: false;
                            property <length> last-pan-x: 0px;
                            property <length> last-pan-y: 0px;

                            mouse-cursor: self.is-eyedropper || self.is-loupe ? crosshair : (self.is-panning ? grabbing : default);

                            pointer-event(ev) => {
                                key-handler.focus();
                                root.context-menu-visible = false;
                                if (!root.has-image || root.is-multi-selection) {
                                    return;
                                }
                                if (ev.kind == PointerEventKind.down) {
                                    if (ev.button == PointerEventButton.left) {
                                        self.is-panning = true;
                                        self.last-pan-x = self.mouse-x;
                                        self.last-pan-y = self.mouse-y;
                                    } else if (ev.button == PointerEventButton.right) {
                                        self.is-eyedropper = true;
                                        root.eyedropper-visible = true;
                                        root.canvas-inspect-pixel(
                                            self.mouse-x / 1px,
                                            self.mouse-y / 1px,
                                            parent.width / 1px,
                                            parent.height / 1px
                                        );
                                    } else if (ev.button == PointerEventButton.middle) {
                                        self.is-loupe = true;
                                        root.loupe-visible = true;
                                        root.canvas-inspect-loupe(
                                            self.mouse-x / 1px,
                                            self.mouse-y / 1px,
                                            parent.width / 1px,
                                            parent.height / 1px
                                        );
                                    }
                                } else if (ev.kind == PointerEventKind.move) {
                                    if (self.is-panning) {
                                        root.canvas-pan(
                                            (self.mouse-x - self.last-pan-x) / 1px,
                                            (self.mouse-y - self.last-pan-y) / 1px
                                        );
                                        self.last-pan-x = self.mouse-x;
                                        self.last-pan-y = self.mouse-y;
                                    }
                                    if (self.is-eyedropper) {
                                        root.canvas-inspect-pixel(
                                            self.mouse-x / 1px,
                                            self.mouse-y / 1px,
                                            parent.width / 1px,
                                            parent.height / 1px
                                        );
                                    }
                                    if (self.is-loupe) {
                                        root.canvas-inspect-loupe(
                                            self.mouse-x / 1px,
                                            self.mouse-y / 1px,
                                            parent.width / 1px,
                                            parent.height / 1px
                                        );
                                    }
                                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                    if (ev.button == PointerEventButton.left) {
                                        self.is-panning = false;
                                    } else if (ev.button == PointerEventButton.right) {
                                        self.is-eyedropper = false;
                                        root.eyedropper-visible = false;
                                    } else if (ev.button == PointerEventButton.middle) {
                                        self.is-loupe = false;
                                        root.loupe-visible = false;
                                    } else {
                                        self.is-panning = false;
                                        self.is-eyedropper = false;
                                        self.is-loupe = false;
                                        root.eyedropper-visible = false;
                                        root.loupe-visible = false;
                                    }
                                }
                            }

                            scroll-event(ev) => {
                                if (root.has-image && !root.is-multi-selection && ev.delta-y != 0px) {
                                    root.canvas-wheel(
                                        ev.delta-y / 1px,
                                        self.mouse-x / 1px,
                                        self.mouse-y / 1px,
                                        parent.width / 1px,
                                        parent.height / 1px
                                    );
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        // Interactive Crop Tool Overlay (Task 9)
                        if root.has-image && !root.is-multi-selection && root.crop-active : crop-overlay := Rectangle {
                            width: 100%;
                            height: 100%;

                            // Calculated geometry of the image on canvas
                            property <length> img-w: (root.image-pixel-width * root.view-zoom) * 1px;
                            property <length> img-h: (root.image-pixel-height * root.view-zoom) * 1px;
                            property <length> img-x: ((parent.width - self.img-w) / 2.0) + (root.pan-x * 1px);
                            property <length> img-y: ((parent.height - self.img-h) / 2.0) + (root.pan-y * 1px);

                            // Calculated geometry of the crop rectangle
                            property <length> c-x: Math.round((self.img-x + self.img-w * root.crop-norm-x) / 1px) * 1px;
                            property <length> c-y: Math.round((self.img-y + self.img-h * root.crop-norm-y) / 1px) * 1px;
                            property <length> c-w: max(20px, Math.round((self.img-w * root.crop-norm-w) / 1px) * 1px);
                            property <length> c-h: max(20px, Math.round((self.img-h * root.crop-norm-h) / 1px) * 1px);

                            // 4 Dimmed Dark Shading Rectangles around the crop box
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: max(0px, crop-overlay.c-y);
                                background: #00000088;
                            }
                            Rectangle {
                                x: 0px;
                                y: crop-overlay.c-y + crop-overlay.c-h;
                                width: 100%;
                                height: max(0px, parent.height - (crop-overlay.c-y + crop-overlay.c-h));
                                background: #00000088;
                            }
                            Rectangle {
                                x: 0px;
                                y: crop-overlay.c-y;
                                width: max(0px, crop-overlay.c-x);
                                height: crop-overlay.c-h;
                                background: #00000088;
                            }
                            Rectangle {
                                x: crop-overlay.c-x + crop-overlay.c-w;
                                y: crop-overlay.c-y;
                                width: max(0px, parent.width - (crop-overlay.c-x + crop-overlay.c-w));
                                height: crop-overlay.c-h;
                                background: #00000088;
                            }

                            // The Crop Box Rectangle with rule-of-thirds grid
                            Rectangle {
                                x: crop-overlay.c-x;
                                y: crop-overlay.c-y;
                                width: crop-overlay.c-w;
                                height: crop-overlay.c-h;
                                border-width: 1.5px;
                                border-color: #FFFFFFEE;

                                // Rule of thirds grid lines
                                Rectangle {
                                    x: 0px;
                                    y: parent.height / 3.0;
                                    width: parent.width;
                                    height: 1px;
                                    background: #FFFFFF44;
                                }
                                Rectangle {
                                    x: 0px;
                                    y: (parent.height * 2.0) / 3.0;
                                    width: parent.width;
                                    height: 1px;
                                    background: #FFFFFF44;
                                }
                                Rectangle {
                                    x: parent.width / 3.0;
                                    y: 0px;
                                    width: 1px;
                                    height: parent.height;
                                    background: #FFFFFF44;
                                }
                                Rectangle {
                                    x: (parent.width * 2.0) / 3.0;
                                    y: 0px;
                                    width: 1px;
                                    height: parent.height;
                                    background: #FFFFFF44;
                                }

                                // Draggable Crop Body (Move Crop Area)
                                crop-body-touch := TouchArea {
                                    x: 12px;
                                    y: 12px;
                                    width: max(0px, parent.width - 24px);
                                    height: max(0px, parent.height - 24px);
                                    mouse-cursor: move;
                                    property <length> start-canvas-x: 0px;
                                    property <length> start-canvas-y: 0px;
                                    property <float> orig-x: 0.0;
                                    property <float> orig-y: 0.0;
                                    property <bool> is-dragging: false;

                                    double-clicked => {
                                        root.apply-crop();
                                    }

                                    pointer-event(ev) => {
                                        key-handler.focus();
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                            self.is-dragging = true;
                                            self.start-canvas-x = crop-overlay.c-x + self.x + self.mouse-x;
                                            self.start-canvas-y = crop-overlay.c-y + self.y + self.mouse-y;
                                            self.orig-x = root.crop-norm-x;
                                            self.orig-y = root.crop-norm-y;
                                        } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                            let cur-x = crop-overlay.c-x + self.x + self.mouse-x;
                                            let cur-y = crop-overlay.c-y + self.y + self.mouse-y;
                                            let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                            let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                            let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                            let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                            root.crop-norm-x = max(0.0, min(1.0 - root.crop-norm-w, self.orig-x + dnx));
                                            root.crop-norm-y = max(0.0, min(1.0 - root.crop-norm-h, self.orig-y + dny));
                                        } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                            self.is-dragging = false;
                                        }
                                    }
                                }

                                // Handles (NW, NE, SW, SE, N, S, W, E)
                                Rectangle {
                                    x: -2px; y: -2px; width: 14px; height: 14px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: nw-resize;
                                        property <length> start-canvas-x: 0px;
                                        property <length> start-canvas-y: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                self.start-canvas-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-w = root.crop-norm-w;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                let cur-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                                let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                                let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                                let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                                let r-norm = (root.crop-aspect-ratio > 0.0) ? (root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width))) : 0.0;
                                                let orig-r = self.orig-x + self.orig-w;
                                                let orig-b = self.orig-y + self.orig-h;
                                                let target-x = max(0.0, min(orig-r - 0.05, self.orig-x + dnx));
                                                let nw = orig-r - target-x;
                                                if (r-norm > 0.0) {
                                                    let nh = nw / r-norm;
                                                    let target-y = orig-b - nh;
                                                    if (target-y >= 0.0) {
                                                        root.crop-norm-x = target-x;
                                                        root.crop-norm-y = target-y;
                                                        root.crop-norm-w = nw;
                                                        root.crop-norm-h = nh;
                                                    }
                                                } else {
                                                    let target-y = max(0.0, min(orig-b - 0.05, self.orig-y + dny));
                                                    let nh = orig-b - target-y;
                                                    root.crop-norm-x = target-x;
                                                    root.crop-norm-y = target-y;
                                                    root.crop-norm-w = nw;
                                                    root.crop-norm-h = nh;
                                                }
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    x: parent.width - 12px; y: -2px; width: 14px; height: 14px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: ne-resize;
                                        property <length> start-canvas-x: 0px;
                                        property <length> start-canvas-y: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                self.start-canvas-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-w = root.crop-norm-w;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                let cur-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                                let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                                let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                                let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                                let r-norm = (root.crop-aspect-ratio > 0.0) ? (root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width))) : 0.0;
                                                let orig-b = self.orig-y + self.orig-h;
                                                let nw = max(0.05, min(1.0 - self.orig-x, self.orig-w + dnx));
                                                if (r-norm > 0.0) {
                                                    let nh = nw / r-norm;
                                                    let target-y = orig-b - nh;
                                                    if (target-y >= 0.0) {
                                                        root.crop-norm-y = target-y;
                                                        root.crop-norm-w = nw;
                                                        root.crop-norm-h = nh;
                                                    }
                                                } else {
                                                    let target-y = max(0.0, min(orig-b - 0.05, self.orig-y + dny));
                                                    let nh = orig-b - target-y;
                                                    root.crop-norm-y = target-y;
                                                    root.crop-norm-w = nw;
                                                    root.crop-norm-h = nh;
                                                }
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    x: -2px; y: parent.height - 12px; width: 14px; height: 14px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: sw-resize;
                                        property <length> start-canvas-x: 0px;
                                        property <length> start-canvas-y: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                self.start-canvas-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-w = root.crop-norm-w;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                let cur-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                                let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                                let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                                let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                                let r-norm = (root.crop-aspect-ratio > 0.0) ? (root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width))) : 0.0;
                                                let orig-r = self.orig-x + self.orig-w;
                                                let target-x = max(0.0, min(orig-r - 0.05, self.orig-x + dnx));
                                                let nw = orig-r - target-x;
                                                if (r-norm > 0.0) {
                                                    let nh = nw / r-norm;
                                                    if (self.orig-y + nh <= 1.0) {
                                                        root.crop-norm-x = target-x;
                                                        root.crop-norm-w = nw;
                                                        root.crop-norm-h = nh;
                                                    }
                                                } else {
                                                    let nh = max(0.05, min(1.0 - self.orig-y, self.orig-h + dny));
                                                    root.crop-norm-x = target-x;
                                                    root.crop-norm-w = nw;
                                                    root.crop-norm-h = nh;
                                                }
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    x: parent.width - 12px; y: parent.height - 12px; width: 14px; height: 14px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: se-resize;
                                        property <length> start-canvas-x: 0px;
                                        property <length> start-canvas-y: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                self.start-canvas-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-w = root.crop-norm-w;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                let cur-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                                let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                                let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                                let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                                let r-norm = (root.crop-aspect-ratio > 0.0) ? (root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width))) : 0.0;
                                                let nw = max(0.05, min(1.0 - self.orig-x, self.orig-w + dnx));
                                                if (r-norm > 0.0) {
                                                    let nh = nw / r-norm;
                                                    if (self.orig-y + nh <= 1.0) {
                                                        root.crop-norm-w = nw;
                                                        root.crop-norm-h = nh;
                                                    }
                                                } else {
                                                    let nh = max(0.05, min(1.0 - self.orig-y, self.orig-h + dny));
                                                    root.crop-norm-w = nw;
                                                    root.crop-norm-h = nh;
                                                }
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                // Top Edge (N)
                                Rectangle {
                                    x: (parent.width - 24px) / 2.0; y: -2px; width: 24px; height: 6px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: n-resize;
                                        property <length> start-canvas-y: 0px;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                                let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                                let orig-b = self.orig-y + self.orig-h;
                                                let target-y = max(0.0, min(orig-b - 0.05, self.orig-y + dny));
                                                root.crop-norm-y = target-y;
                                                root.crop-norm-h = orig-b - target-y;
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                // Bottom Edge (S)
                                Rectangle {
                                    x: (parent.width - 24px) / 2.0; y: parent.height - 4px; width: 24px; height: 6px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: s-resize;
                                        property <length> start-canvas-y: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-w = root.crop-norm-w;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-y = crop-overlay.c-y + parent.y + self.mouse-y;
                                                let eff-h = max(1.0, crop-overlay.img-h / 1px);
                                                let dny = ((cur-y - self.start-canvas-y) / 1px) / eff-h;
                                                let r-norm = (root.crop-aspect-ratio > 0.0) ? (root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width))) : 0.0;
                                                let nh = max(0.05, min(1.0 - self.orig-y, self.orig-h + dny));
                                                if (r-norm > 0.0) {
                                                    let nw = nh * r-norm;
                                                    if (self.orig-x + nw <= 1.0) {
                                                        root.crop-norm-w = nw;
                                                        root.crop-norm-h = nh;
                                                    }
                                                } else {
                                                    root.crop-norm-h = nh;
                                                }
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                // Left Edge (W)
                                Rectangle {
                                    x: -2px; y: (parent.height - 24px) / 2.0; width: 6px; height: 24px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: w-resize;
                                        property <length> start-canvas-x: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-w = root.crop-norm-w;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                                let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                                let orig-r = self.orig-x + self.orig-w;
                                                let target-x = max(0.0, min(orig-r - 0.05, self.orig-x + dnx));
                                                root.crop-norm-x = target-x;
                                                root.crop-norm-w = orig-r - target-x;
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }

                                // Right Edge (E)
                                Rectangle {
                                    x: parent.width - 4px; y: (parent.height - 24px) / 2.0; width: 6px; height: 24px; background: #FFFFFF; border-radius: 1px;
                                    TouchArea {
                                        mouse-cursor: e-resize;
                                        property <length> start-canvas-x: 0px;
                                        property <float> orig-x: 0.0;
                                        property <float> orig-y: 0.0;
                                        property <float> orig-w: 0.0;
                                        property <float> orig-h: 0.0;
                                        property <bool> is-dragging: false;
                                        pointer-event(ev) => {
                                            key-handler.focus();
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                self.is-dragging = true;
                                                self.start-canvas-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                self.orig-x = root.crop-norm-x;
                                                self.orig-y = root.crop-norm-y;
                                                self.orig-w = root.crop-norm-w;
                                                self.orig-h = root.crop-norm-h;
                                            } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                                let cur-x = crop-overlay.c-x + parent.x + self.mouse-x;
                                                let eff-w = max(1.0, crop-overlay.img-w / 1px);
                                                let dnx = ((cur-x - self.start-canvas-x) / 1px) / eff-w;
                                                let r-norm = (root.crop-aspect-ratio > 0.0) ? (root.crop-aspect-ratio * (root.image-pixel-height / max(1, root.image-pixel-width))) : 0.0;
                                                let nw = max(0.05, min(1.0 - self.orig-x, self.orig-w + dnx));
                                                if (r-norm > 0.0) {
                                                    let nh = nw / r-norm;
                                                    if (self.orig-y + nh <= 1.0) {
                                                        root.crop-norm-w = nw;
                                                        root.crop-norm-h = nh;
                                                    }
                                                } else {
                                                    root.crop-norm-w = nw;
                                                }
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.is-dragging = false;
                                            }
                                        }
                                    }
                                }
                            }

                            // Floating Crop Action Bar at bottom center of canvas
                            Rectangle {
                                x: (parent.width - self.width) / 2.0;
                                y: parent.height - 56px;
                                height: 38px;
                                background: #1C1C1CEE;
                                border-width: 1px;
                                border-color: #404040;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 10px;
                                    alignment: center;

                                    Text {
                                        text: "Crop: "
                                            + Math.round(root.crop-norm-w * root.image-pixel-width) + " × "
                                            + Math.round(root.crop-norm-h * root.image-pixel-height) + " px ("
                                            + root.crop-aspect-label + ")";
                                        color: #D0D0D0;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { width: 1px; height: 18px; background: #383838; }

                                    Win10Button {
                                        text: "Apply (Enter)";
                                        primary: true;
                                        height: 26px;
                                        has-icon: true;
                                        icon: @image-url("../assets/icons/check.svg");
                                        clicked => { root.apply-crop(); }
                                    }

                                    Win10Button {
                                        text: "Reset";
                                        height: 26px;
                                        clicked => { root.init-crop-box(); }
                                    }

                                    Win10Button {
                                        text: "Cancel (Esc)";
                                        height: 26px;
                                        clicked => { root.crop-active = false; }
                                    }
                                }
                            }
                        }

                        // Floating Eyedropper Overlay (Right-Click Hold) with Large 88x88 Swatch + XY + RGB + HSL
                        if root.eyedropper-visible : Rectangle {
                            x: root.eyedropper-x;
                            y: root.eyedropper-y;
                            width: 288px;
                            height: 118px;
                            background: #1F1F1FF2;
                            border-width: 1px;
                            border-color: #555555;

                            // Large 88x88 Color Swatch
                            Rectangle {
                                x: 14px;
                                y: 15px;
                                width: 88px;
                                height: 88px;
                                background: root.eyedropper-color;
                                border-width: 1.5px;
                                border-color: #F0F0F0;
                            }

                            Text {
                                x: 114px;
                                y: 20px;
                                text: root.eyedropper-xy-text;
                                color: #B0B0B0;
                                font-size: 12px;
                                font-weight: 600;
                            }

                            Text {
                                x: 114px;
                                y: 50px;
                                text: root.eyedropper-rgb-text;
                                color: #F3F3F3;
                                font-family: "Consolas";
                                font-size: 13px;
                                font-weight: 700;
                            }

                            Text {
                                x: 114px;
                                y: 80px;
                                text: root.eyedropper-hsl-text;
                                color: #E0E0E0;
                                font-family: "Consolas";
                                font-size: 13px;
                                font-weight: 700;
                            }
                        }

                        // Floating Magnifier Loupe Overlay (Middle-Click Hold, 4x dynamic magnification)
                        if root.loupe-visible : Rectangle {
                            x: root.loupe-x;
                            y: root.loupe-y;
                            width: 332px;
                            height: 356px;
                            background: transparent;

                            Rectangle {
                                x: 6px;
                                y: 6px;
                                width: 320px;
                                height: 320px;
                                background: #141414;
                                border-width: 2.5px;
                                border-color: #888888;
                                border-radius: 160px;
                                clip: true;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: root.loupe-image;
                                    image-rendering: pixelated;
                                }

                                // Center Crosshair
                                Rectangle {
                                    x: 140px;
                                    y: 159px;
                                    width: 40px;
                                    height: 1px;
                                    background: #FFFFFFCC;
                                }
                                Rectangle {
                                    x: 159px;
                                    y: 140px;
                                    width: 1px;
                                    height: 40px;
                                    background: #FFFFFFCC;
                                }
                            }

                            Rectangle {
                                x: 66px;
                                y: 330px;
                                width: 200px;
                                height: 22px;
                                background: #1F1F1FF2;
                                border-width: 1px;
                                border-color: #555555;

                                Text {
                                    text: root.loupe-badge-text;
                                    color: #F3F3F3;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Unified Non-Overlapping Floating Badges Container on Canvas
                        if root.has-image && !root.is-multi-selection && (root.current-file-deleted || root.current-file-modified || root.current-file-renamed || root.current-file-new || root.current-image-is-cropped) : VerticalLayout {
                            x: 20px;
                            y: 20px;
                            spacing: 8px;
                            alignment: start;

                            // Floating Overlay Warning when file is deleted from disk
                            if root.current-file-deleted : HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 38px;
                                    background: #6E1212F5;
                                    border-width: 1.5px;
                                    border-color: #E81123;
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/warning.svg");
                                            width: 18px;
                                            height: 18px;
                                            image-fit: contain;
                                            colorize: #E81123;
                                            y: (parent.height - self.height) / 2.0;
                                        }

                                        Text {
                                            text: "File deleted from disk — Viewing in-memory copy";
                                            color: #FFFFFF;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Floating Overlay Notice when file is modified on disk (hidden if deleted)
                            if !root.current-file-deleted && root.current-file-modified : HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 38px;
                                    background: #5A3A00F5;
                                    border-width: 1.5px;
                                    border-color: #D97706;
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/refresh.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: #D97706;
                                            y: (parent.height - self.height) / 2.0;
                                        }

                                        Text {
                                            text: "File modified on disk — Reloaded";
                                            color: #FFFFFF;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Floating Overlay Notice when file is renamed on disk (hidden if deleted or modified)
                            if !root.current-file-deleted && !root.current-file-modified && root.current-file-renamed : HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 38px;
                                    background: #2D2D33F5;
                                    border-width: 1.5px;
                                    border-color: #666666;
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/edit.svg");
                                            width: 16px;
                                            height: 16px;
                                            image-fit: contain;
                                            colorize: #FFFFFF;
                                            y: (parent.height - self.height) / 2.0;
                                        }

                                        Text {
                                            text: "File renamed on disk";
                                            color: #FFFFFF;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Floating Overlay Notice when new file is added to folder
                            if !root.current-file-deleted && !root.current-file-modified && !root.current-file-renamed && root.current-file-new : HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 38px;
                                    background: #144723F5;
                                    border-width: 1.5px;
                                    border-color: #107C41;
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        Text {
                                            text: "✨";
                                            font-size: 15px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "New file added to folder";
                                            color: #FFFFFF;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Floating Badge indicating image has unsaved crop modifications
                            if root.current-image-is-cropped : HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 46px;
                                    background: #005A9EF2;
                                    border-width: 1px;
                                    border-color: #0098FF;
                                    border-radius: 4px;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/crop.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: #FFFFFF;
                                            y: (parent.height - self.height) / 2.0;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: "CROPPED";
                                                color: #FFFFFF;
                                                font-size: 11px;
                                                font-weight: 700;
                                            }
                                            Text {
                                                text: "Save image to keep modifications";
                                                color: #E6E6E6;
                                                font-size: 13px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Notice shown where the user is looking: outcome of an action (with
                        // Undo when it can be undone) or an error that needs to be read.
                        if root.notice-visible : Rectangle {
                            width: min(parent.width - 32px, 680px);
                            height: notice-row.preferred-height;
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - 16px;
                            background: root.notice-is-error ? #3A2020 : #2A2A2A;
                            border-width: 1px;
                            border-color: root.notice-is-error ? #D9534F : #4A4A4A;
                            border-radius: 6px;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000080;
                            accessible-role: text;
                            accessible-label: root.notice-text;

                            notice-row := HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 10px;

                                Text {
                                    text: root.notice-is-error ? "⚠" : "✓";
                                    color: root.notice-is-error ? #FF8A80 : #7CC47C;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                                // Read-only TextInput: the text can be selected and copied.
                                TextInput {
                                    text: root.notice-text;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: #F2F2F2;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                if root.notice-action-text != "" : Win10Button {
                                    text: root.notice-action-text;
                                    primary: true;
                                    y: (parent.height - self.height) / 2;
                                    accessible-role: button;
                                    accessible-label: root.notice-action-text;
                                    clicked => { root.notice-action(); }
                                }
                                Win10Button {
                                    icon-text: "✕";
                                    width: 30px;
                                    y: (parent.height - self.height) / 2;
                                    accessible-role: button;
                                    accessible-label: "Close";
                                    clicked => { root.notice-dismiss(); }
                                }
                            }
                        }
                    }

                    // --- BOTTOM FILMSTRIP ---
                    filmstrip-container := Rectangle {
                        height: 156px;
                        background: #181818;
                        border-width: 1px;
                        border-color: #282828;
                        clip: true;

                        // Touch area over the filmstrip to capture mouse wheel scrolling anywhere on the filmstrip
                        TouchArea {
                            scroll-event(ev) => {
                                root.scroll-filmstrip(ev.delta-y, ev.delta-x);
                                return accept;
                            }
                        }

                        HorizontalLayout {
                            x: root.filmstrip-offset-x;
                            y: 4px;
                            height: 136px;
                            spacing: 6px;
                            alignment: start;

                            for item[idx] in root.filmstrip-items : Rectangle {
                                width: 156px;
                                height: 136px;
                                background: item.selected ? #2D2D2D : (thumb-touch.has-hover ? #222222 : #161616);
                                border-width: item.selected ? 2px : 1px;
                                border-color: item.selected ? #6A6A6A : #262626;
                                border-radius: 2px;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;

                                    Rectangle {
                                        height: 88px;
                                        background: #101010;
                                        border-width: 1px;
                                        border-color: #242424;
                                        opacity: item.badge_type == "deleted" ? 0.60 : 1.0;

                                        if item.has_thumbnail : Image {
                                            width: 100%;
                                            height: 100%;
                                            source: item.thumbnail;
                                            image-fit: contain;
                                        }
                                        if !item.has_thumbnail : Text {
                                            text: "Loading...";
                                            color: #777777;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        // Indicators Container (Cropped non-overlapping, Task 3)
                                        HorizontalLayout {
                                            x: 4px;
                                            y: 4px;
                                            spacing: 4px;
                                            alignment: start;

                                            if item.is_cropped : Rectangle {
                                                height: 18px;
                                                background: #0078D7EE;
                                                border-width: 1px;
                                                border-color: #0098FF;
                                                border-radius: 2px;

                                                HorizontalLayout {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    spacing: 3px;
                                                    Image {
                                                        source: @image-url("../assets/icons/crop.svg");
                                                        width: 10px;
                                                        height: 10px;
                                                        colorize: #FFFFFF;
                                                        y: (parent.height - self.height) / 2.0;
                                                    }
                                                    Text {
                                                        text: "Crop";
                                                        color: #FFFFFF;
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        // Status Badge Pill in Bottom-Right of thumbnail (guaranteed never to overlap with top indicators)
                                        if item.badge_text != "" : Rectangle {
                                            x: parent.width - self.width - 4px;
                                            y: parent.height - self.height - 4px;
                                            height: 18px;
                                            background: item.badge_type == "deleted" ? #D83B01EE : (item.badge_type == "renamed" ? #4A4A4AEE : (item.badge_type == "modified" ? #D97706EE : #107C41EE));
                                            border-width: 1px;
                                            border-color: item.badge_type == "deleted" ? #DE4848 : (item.badge_type == "renamed" ? #888888 : (item.badge_type == "modified" ? #E3A83C : #58B05C));
                                            border-radius: 2px;

                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                Text {
                                                    text: item.badge_text;
                                                    color: #CCCCCC;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Filename Label
                                    Text {
                                        text: item.label;
                                        color: item.selected ? #E5E5E5 : #CCCCCC;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }

                                    // Interactive Rating row directly on the filmstrip item
                                    HorizontalLayout {
                                        height: 16px;
                                        alignment: center;
                                        spacing: 2px;
                                        for star-idx in [1, 2, 3, 4, 5] : Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            background: transparent;
                                            Text {
                                                text: item.rating >= star-idx ? "★" : "·";
                                                color: item.rating >= star-idx ? #E8C43A : (star-touch.has-hover ? #E8C43A : #666666);
                                                font-size: item.rating >= star-idx ? 12px : 14px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            star-touch := TouchArea {
                                                clicked => {
                                                    root.rate-filmstrip-item(idx, item.rating == star-idx ? 0 : star-idx);
                                                }
                                            }
                                        }
                                    }
                                }

                                thumb-touch := TouchArea {
                                    y: 0px;
                                    height: 114px;
                                    clicked => {
                                        key-handler.focus();
                                        root.film-menu-visible = false;
                                        root.context-menu-visible = false;
                                        root.profile-dropdown-open = false;
                                        root.filmstrip-item-clicked(idx, root.is-ctrl-pressed, root.is-shift-pressed);
                                    }
                                    scroll-event(ev) => {
                                        root.scroll-filmstrip(ev.delta-y, ev.delta-x);
                                        return accept;
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                            if (ev.modifiers.control) { root.is-ctrl-pressed = true; }
                                            if (ev.modifiers.shift) { root.is-shift-pressed = true; }
                                        }
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                            root.context-menu-visible = false;
                                            root.profile-dropdown-open = false;
                                            root.open-with-submenu-visible = false;
                                            if (!item.selected) {
                                                root.filmstrip-item-clicked(idx, false, false);
                                                root.selected-files-count = 1;
                                            }
                                            root.film-menu-target-path = item.full_path;
                                            root.film-menu-target-name = item.label;
                                            root.request-open-with-apps(item.full_path);
                                            let gx = 245px + (idx * 162 + 6) * 1px + root.filmstrip-offset-x + self.mouse-x;
                                            root.film-menu-x = max(10px, min(root.width - 255px, gx));
                                            root.film-menu-y = max(40px, root.height - 175px);
                                            root.film-menu-visible = true;
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Horizontal Scrollbar with Interactive Mouse Drag & Track Click
                        if (root.filmstrip-items.length * 162 + 12) * 1px > filmstrip-container.width : Rectangle {
                            y: parent.height - 12px;
                            height: 12px;
                            width: 100%;
                            background: #1C1C1D;
                            border-width: 1px;
                            border-color: #2D2D30;

                            property <float> total-w-flt: max(1.0, (root.filmstrip-items.length * 162 + 12));
                            property <float> cont-w-flt: max(1.0, filmstrip-container.width / 1px);
                            property <float> visible-ratio: min(1.0, cont-w-flt / total-w-flt);
                            property <float> scroll-ratio: (-root.filmstrip-offset-x / 1px) / max(1.0, total-w-flt - cont-w-flt);
                            property <length> thumb-w: max(48px, filmstrip-container.width * visible-ratio);
                            property <length> thumb-x: (filmstrip-container.width - thumb-w) * scroll-ratio;

                            // Interactive Drag & Click TouchArea
                            sb-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                property <bool> dragging: false;
                                property <length> drag-start-mx: 0px;
                                property <length> drag-start-offset: 0px;

                                mouse-cursor: pointer;

                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                        let track-avail = filmstrip-container.width - thumb-w;
                                        if (track-avail > 0px) {
                                            let total-w = (root.filmstrip-items.length * 162 + 12) * 1px;
                                            let scrollable = total-w - filmstrip-container.width;

                                            // If clicked outside the thumb, jump thumb center directly to clicked spot
                                            if (self.mouse-x < thumb-x || self.mouse-x > thumb-x + thumb-w) {
                                                let click-ratio = max(0.0, min(1.0, (self.mouse-x - thumb-w * 0.5) / track-avail));
                                                root.filmstrip-offset-x = max(-scrollable, min(0px, -click-ratio * scrollable));
                                            }

                                            self.dragging = true;
                                            self.drag-start-mx = self.mouse-x;
                                            self.drag-start-offset = root.filmstrip-offset-x;
                                        }
                                    } else if (ev.kind == PointerEventKind.move) {
                                        if (self.dragging) {
                                            let track-avail = filmstrip-container.width - thumb-w;
                                            if (track-avail > 0px) {
                                                let total-w = (root.filmstrip-items.length * 162 + 12) * 1px;
                                                let scrollable = total-w - filmstrip-container.width;
                                                let delta-mx = self.mouse-x - self.drag-start-mx;
                                                let delta-offset = delta-mx * (scrollable / track-avail);
                                                let target = self.drag-start-offset - delta-offset;
                                                root.filmstrip-offset-x = max(-scrollable, min(0px, target));
                                            }
                                        }
                                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                        self.dragging = false;
                                    }
                                }
                            }

                            // Draggable Thumb Pill
                            Rectangle {
                                x: thumb-x;
                                y: 2px;
                                width: thumb-w;
                                height: 8px;
                                border-radius: 4px;
                                background: sb-touch.dragging ? #999999 : (sb-touch.has-hover ? #777777 : #5A5A5C);
                                border-width: 1px;
                                border-color: sb-touch.dragging ? #CCCCCC : (sb-touch.has-hover ? #999999 : #68686A);
                            }
                        }
                    }
                }

                // Right Panel Resize Splitter (Task 3)
                if root.right-panel-visible : Rectangle {
                    width: 5px;
                    background: right-split.pressed || right-split.has-hover ? #007ACC : #1E1E1E;
                    right-split := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        property <length> start-w;
                        property <length> start-x;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                self.start-w = root.right-panel-width;
                                self.start-x = self.mouse-x;
                            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                                let delta = self.start-x - self.mouse-x;
                                root.right-panel-width = max(180px, min(500px, self.start-w + delta));
                            }
                        }
                    }
                }

                // --- RIGHT SIDEBAR (Histogram & Metadata Panel) ---
                if root.right-panel-visible : Rectangle {
                    width: root.right-panel-width;
                    background: #202020;
                    border-width: 1px;
                    border-color: #1C1C1C;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;

                        Text {
                            text: "HISTOGRAM & METADATA";
                            color: #B0B0B0;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Text {
                            text: "RGB & Luminance Histogram";
                            color: #BFBFBF;
                            font-size: 13px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 130px;
                            background: #141414;
                            border-width: 1px;
                            border-color: #333337;

                            if root.has-image : Image {
                                width: 100%;
                                height: 100%;
                                source: root.histogram-image;
                                image-fit: fill;
                            }
                            if !root.has-image : Text {
                                text: "No Histogram Data";
                                color: #808080;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Color Management";
                            color: #BFBFBF;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Rectangle {
                            height: 68px;
                            background: #252526;
                            border-width: 1px;
                            border-color: #333337;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Text {
                                    text: root.meta-embedded-icc;
                                    color: #CCCCCC;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.meta-active-icc;
                                    color: #E0E0E0;
                                    font-size: 11px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.meta-display-icc;
                                    color: #999999;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }

                        Text {
                            text: "Image & EXIF Properties";
                            color: #BFBFBF;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: #1A1A1A;
                            border-width: 1px;
                            border-color: #333337;

                            ScrollView {
                                VerticalLayout {
                                    alignment: start;
                                    for row in root.metadata-rows : Rectangle {
                                        height: 26px;
                                        border-width: 0.5px;
                                        border-color: #252526;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            Text {
                                                width: 95px;
                                                text: row.key;
                                                color: #8A8A8A;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: row.value;
                                                color: #BFBFBF;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 4. Status Bar
            Rectangle {
                height: 26px;
                background: #1C1C1C;
                border-width: 1px;
                border-color: #262626;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 16px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-file-text;
                        color: #8E8E8E;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.status-task-text != "" : Text {
                        text: root.status-task-text;
                        color: #4FA3E0;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.status-eyedropper-text;
                        color: #8E8E8E;
                        font-family: "Consolas";
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.status-cache-text;
                        color: #8E8E8E;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Right-Click Context Menu Popup for Recent Folders
        if root.context-menu-visible : Rectangle {
            x: root.context-menu-x;
            y: root.context-menu-y;
            width: 225px;
            height: 62px;
            background: #252526;
            border-width: 1px;
            border-color: #454545;

            VerticalLayout {
                padding: 2px;
                Rectangle {
                    height: 28px;
                    background: rm-touch.has-hover ? #383838 : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            text: "Remove '" + root.context-menu-target-name + "' from Recent";
                            color: #F2F2F2;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    rm-touch := TouchArea {
                        clicked => {
                            root.context-menu-visible = false;
                            root.recent-folder-remove(root.context-menu-target-path);
                        }
                    }
                }
                Rectangle { height: 1px; background: #383838; }
                Rectangle {
                    height: 28px;
                    background: clr-touch.has-hover ? #383838 : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            text: "Clear Recent Folders List";
                            color: #F2F2F2;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                        clr-touch := TouchArea {
                            clicked => {
                                root.context-menu-visible = false;
                                root.recent-folders-clear();
                            }
                        }
                    }
                }
            }

            // Full-Height Color Profile Dropdown Menu (shows all profiles without scrolling)
            if root.profile-dropdown-open : TouchArea {
                width: 100%;
                height: 100%;
                z: 105;
                clicked => {
                    root.profile-dropdown-open = false;
                }

                Rectangle {
                    x: min(root.width - 275px, max(10px, profile-box.absolute-position.x));
                    y: profile-box.absolute-position.y + profile-box.height + 4px;
                    width: 265px;
                    height: (root.profile-list.length * 28 + 6) * 1px;
                    background: #252526;
                    border-width: 1px;
                    border-color: #555555;

                    VerticalLayout {
                        padding: 3px;
                        spacing: 0px;

                        for prof in root.profile-list : Rectangle {
                            height: 28px;
                            background: item-touch.has-hover ? #383838 : (prof == root.current-profile ? #303030 : transparent);

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;

                                Text {
                                    text: prof == root.current-profile ? "✓" : " ";
                                    width: 14px;
                                    color: #E0E0E0;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: prof;
                                    color: #F2F2F2;
                                    font-size: 12px;
                                    font-weight: prof == root.current-profile ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            item-touch := TouchArea {
                                clicked => {
                                    root.profile-dropdown-open = false;
                                    root.current-profile = prof;
                                    root.profile-selected(prof);
                                }
                            }
                        }
                    }
                }
            }

            // Filmstrip Thumbnail Right-Click Context Menu
            if root.film-menu-visible : TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.film-menu-visible = false;
                    root.open-with-submenu-visible = false;
                }

                Rectangle {
                    x: root.film-menu-x;
                    y: min(root.height - 205px, root.film-menu-y);
                    width: 250px;
                    height: 198px;
                    background: #202020;
                    border-width: 1px;
                    border-color: #383838;
                    border-radius: 3px;

                    VerticalLayout {
                        padding: 3px;
                        spacing: 2px;

                        // 1. Rename file(s)
                        Rectangle {
                            height: 28px;
                            background: ren-touch.has-hover ? #2A2A2A : transparent;
                            border-radius: 2px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Image {
                                        source: @image-url("../assets/icons/edit.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: ren-touch.has-hover ? #FFFFFF : #B0B0B0;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.selected-files-count > 1 ? ("Rename " + root.selected-files-count + " Files...") : "Rename File...";
                                    color: ren-touch.has-hover ? #FFFFFF : #CCCCCC;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            ren-touch := TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.move) { root.open-with-submenu-visible = false; }
                                }
                                clicked => {
                                    root.film-menu-visible = false;
                                    root.open-with-submenu-visible = false;
                                    root.request-rename();
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #2E2E2E; }

                        // 2. Open with...
                        Rectangle {
                            height: 28px;
                            background: (ow-touch.has-hover || root.open-with-submenu-visible) ? #2A2A2A : transparent;
                            border-radius: 2px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Image {
                                        source: @image-url("../assets/icons/external_link.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: (ow-touch.has-hover || root.open-with-submenu-visible) ? #FFFFFF : #B0B0B0;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Open with...";
                                    color: (ow-touch.has-hover || root.open-with-submenu-visible) ? #FFFFFF : #CCCCCC;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                ChevronRight {
                                    stroke: (ow-touch.has-hover || root.open-with-submenu-visible) ? #FFFFFF : #8E8E8E;
                                    y: (parent.height - self.height) / 2.0;
                                }
                            }
                            ow-touch := TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.move || self.has-hover) {
                                        root.open-with-submenu-visible = true;
                                    }
                                }
                                clicked => {
                                    root.open-with-submenu-visible = true;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #2E2E2E; }

                        // 3. Rotate 90° CW
                        Rectangle {
                            height: 28px;
                            background: rotcw-touch.has-hover ? #2A2A2A : transparent;
                            border-radius: 2px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Image {
                                        source: @image-url("../assets/icons/rotate_right.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: rotcw-touch.has-hover ? #FFFFFF : #B0B0B0;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Rotate 90° Right";
                                    color: rotcw-touch.has-hover ? #FFFFFF : #CCCCCC;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            rotcw-touch := TouchArea {
                                clicked => {
                                    root.film-menu-visible = false;
                                    root.open-with-submenu-visible = false;
                                    root.rotate-cw();
                                }
                            }
                        }

                        // 4. Rotate 90° CCW
                        Rectangle {
                            height: 28px;
                            background: rotccw-touch.has-hover ? #2A2A2A : transparent;
                            border-radius: 2px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Image {
                                        source: @image-url("../assets/icons/rotate_left.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: rotccw-touch.has-hover ? #FFFFFF : #B0B0B0;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Rotate 90° Left";
                                    color: rotccw-touch.has-hover ? #FFFFFF : #CCCCCC;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            rotccw-touch := TouchArea {
                                clicked => {
                                    root.film-menu-visible = false;
                                    root.open-with-submenu-visible = false;
                                    root.rotate-ccw();
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #2E2E2E; }

                        // 5. Open Containing Folder
                        Rectangle {
                            height: 28px;
                            background: exp-touch.has-hover ? #2A2A2A : transparent;
                            border-radius: 2px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Image {
                                        source: @image-url("../assets/icons/folder.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: exp-touch.has-hover ? #FFFFFF : #B0B0B0;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Open Containing Folder";
                                    color: exp-touch.has-hover ? #FFFFFF : #CCCCCC;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            exp-touch := TouchArea {
                                clicked => {
                                    root.film-menu-visible = false;
                                    root.open-with-submenu-visible = false;
                                    root.open-containing-folder-explorer(root.film-menu-target-path);
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #2E2E2E; }

                        // 6. Delete selected images
                        Rectangle {
                            height: 28px;
                            background: del-touch.has-hover ? #7A1C1C : transparent;
                            border-radius: 2px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Image {
                                        source: @image-url("../assets/icons/trash.svg");
                                        width: 14px;
                                        height: 14px;
                                        image-fit: contain;
                                        colorize: del-touch.has-hover ? #FF9090 : #E06060;
                                        x: (parent.width - self.width) / 2.0;
                                        y: (parent.height - self.height) / 2.0;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Delete Selected (Recycle Bin)";
                                    color: del-touch.has-hover ? #FFFFFF : #CCCCCC;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            del-touch := TouchArea {
                                clicked => {
                                    root.film-menu-visible = false;
                                    root.open-with-submenu-visible = false;
                                    root.delete-selected-images();
                                }
                            }
                        }
                    }
                }

                // Submenu: Open With Applications List
                if root.open-with-submenu-visible : Rectangle {
                    x: min(root.width - 250px, root.film-menu-x + 252px);
                    y: max(20px, min(root.height - (min(300px, (root.open-with-apps.length * 28 + 44) * 1px)), root.film-menu-y));
                    width: 245px;
                    height: min(300px, (root.open-with-apps.length * 28 + 44) * 1px);
                    background: #202020;
                    border-width: 1px;
                    border-color: #383838;
                    border-radius: 2px;

                    VerticalLayout {
                        padding: 3px;
                        spacing: 2px;

                        if root.open-with-apps.length > 0 : ScrollView {
                            VerticalLayout {
                                spacing: 1px;
                                for app in root.open-with-apps : Rectangle {
                                    height: 28px;
                                    background: app-touch.has-hover ? #2C2C2C : transparent;
                                    border-radius: 2px;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: (parent.height - self.height) / 2.0;
                                            if app.has_icon : Image {
                                                source: app.icon;
                                                width: 16px;
                                                height: 16px;
                                                image-fit: contain;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            if !app.has_icon : Image {
                                                source: @image-url("../assets/icons/image.svg");
                                                width: 14px;
                                                height: 14px;
                                                image-fit: contain;
                                                colorize: app-touch.has-hover ? #FFFFFF : #B0B0B0;
                                                x: (parent.width - self.width) / 2.0;
                                                y: (parent.height - self.height) / 2.0;
                                            }
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: app.name;
                                            color: app-touch.has-hover ? #FFFFFF : #CCCCCC;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    app-touch := TouchArea {
                                        clicked => {
                                            root.film-menu-visible = false;
                                            root.open-with-submenu-visible = false;
                                            root.open-with-app-clicked(app.id, root.film-menu-target-path);
                                        }
                                    }
                                }
                            }
                        }

                        if root.open-with-apps.length > 0 : Rectangle { height: 1px; background: #2E2E2E; }

                        // Choose another app... option (triggers native OS Open With dialog)
                        Rectangle {
                            height: 28px;
                            background: other-app-touch.has-hover ? #2C2C2C : transparent;
                            border-radius: 2px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;

                                Image {
                                    source: @image-url("../assets/icons/settings.svg");
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                    colorize: other-app-touch.has-hover ? #FFFFFF : #B0B0B0;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Choose another app...";
                                    color: other-app-touch.has-hover ? #FFFFFF : #B0B0B0;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            other-app-touch := TouchArea {
                                clicked => {
                                    root.film-menu-visible = false;
                                    root.open-with-submenu-visible = false;
                                    root.open-with-dialog-clicked(root.film-menu-target-path);
                                }
                            }
                        }
                    }
                }
            }


            // Modal Batch & Single Rename Dialog
            if root.rename-dialog-visible : Rectangle {
                width: 100%;
                height: 100%;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #00000099;
                    }
                }

                Rectangle {
                    width: 480px;
                    height: root.rename-file-count > 1 ? 230px : 195px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: #202020;
                    border-width: 1px;
                    border-color: #383838;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                Image {
                                    source: @image-url("../assets/icons/edit.svg");
                                    width: 15px;
                                    height: 15px;
                                    image-fit: contain;
                                    colorize: #E2E2E2;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                Text {
                                    text: root.rename-file-count > 1 ? ("Rename " + root.rename-file-count + " Files") : "Rename File";
                                    color: #E2E2E2;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 2px;
                                background: close-ren-touch.has-hover ? #333333 : transparent;
                                Image {
                                    source: @image-url("../assets/icons/close.svg");
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                    colorize: close-ren-touch.has-hover ? #FFFFFF : #8E8E8E;
                                    x: (parent.width - self.width) / 2.0;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                close-ren-touch := TouchArea {
                                    clicked => {
                                        root.rename-dialog-visible = false;
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.rename-file-count > 1 ?
                                "Enter base name (files will be renamed: Name (1).ext, Name (2).ext, ...):" :
                                "Enter new file name:";
                            color: #A0A0A0;
                            font-size: 11px;
                        }

                        Rectangle {
                            height: 32px;
                            background: #161616;
                            border-width: 1px;
                            border-color: rename-input-field.has-focus ? #5880D0 : #383838;
                            border-radius: 3px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                rename-input-field := TextInput {
                                    text <=> root.rename-input-text;
                                    color: #F0F0F0;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    accepted => {
                                        root.confirm-rename(self.text);
                                    }
                                }
                            }
                        }

                        if root.rename-file-count == 1 && root.rename-extension-text != "" : Text {
                            text: "Original extension preserved if omitted: " + root.rename-extension-text;
                            color: #707070;
                            font-size: 10px;
                        }

                        if root.rename-error-text != "" : Text {
                            text: root.rename-error-text;
                            color: #DE4848;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        Rectangle { vertical-stretch: 1; }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            Win10Button {
                                text: "Cancel";
                                clicked => {
                                    root.rename-dialog-visible = false;
                                }
                            }

                            Win10Button {
                                text: "Rename";
                                primary: true;
                                clicked => {
                                    root.confirm-rename(root.rename-input-text);
                                }
                            }
                        }
                    }
                }
            }

            // Zoom Presets Dropdown Menu
            if root.zoom-popup-open : TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.zoom-popup-open = false;
                }

                Rectangle {
                    x: min(root.width - 96px, max(10px, zoom-btn.absolute-position.x));
                    y: zoom-btn.absolute-position.y + zoom-btn.height + 4px;
                    width: 86px;
                    height: (root.zoom-presets.length * 26 + 6) * 1px;
                    background: #202020;
                    border-width: 1px;
                    border-color: #3E3E42;
                    border-radius: 3px;
                    clip: true;

                    VerticalLayout {
                        padding: 3px;
                        spacing: 0px;

                        for preset in root.zoom-presets : Rectangle {
                            height: 26px;
                            background: zpr-touch.has-hover ? #303030 : (root.zoom-text == preset.label ? #2A2A2A : transparent);

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: start;
                                Text {
                                    text: preset.label;
                                    color: zpr-touch.has-hover ? #E5E5E5 : #CCCCCC;
                                    font-size: 11px;
                                    font-weight: root.zoom-text == preset.label ? 700 : 400;
                                    vertical-alignment: center;
                                }
                            }

                            zpr-touch := TouchArea {
                                clicked => {
                                    root.zoom-popup-open = false;
                                    root.zoom-set-factor(preset.factor);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Transparent Modal Backdrop to dismiss any open dropdown menu on click outside (Task 10)
        // Starts below the 32px menubar so clicking another menubar item immediately opens it (Task 3)
        if root.file-menu-open || root.edit-menu-open || root.view-menu-open || root.help-menu-open || root.crop-aspect-menu-open || root.zoom-popup-open : TouchArea {
            y: 28px;
            width: 100%;
            height: parent.height - 28px;
            z: 80;
            clicked => {
                root.file-menu-open = false;
                root.edit-menu-open = false;
                root.view-menu-open = false;
                root.help-menu-open = false;
                root.crop-aspect-menu-open = false;
                root.profile-dropdown-open = false;
                root.zoom-popup-open = false;
                key-handler.focus();
            }
        }

        // --- Menubar Dropdown Menus (Task 12) ---
        if root.file-menu-open : Rectangle {
            x: file-menu-btn.absolute-position.x;
            y: 28px;
            width: 230px;
            height: file-menu-layout.preferred-height;
            background: #202020;
            border-width: 1px;
            border-color: #383838;
            border-radius: 3px;
            z: 100;

            file-menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                Rectangle {
                    height: 26px;
                    background: f-op-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/image.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Open File(s)..."; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+O"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    f-op-touch := TouchArea {
                        clicked => { root.file-menu-open = false; root.open-files-clicked(); }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: f-fld-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/folder.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Open Folder..."; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+Shift+O"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    f-fld-touch := TouchArea {
                        clicked => { root.file-menu-open = false; root.open-folder-clicked(); }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: f-sav-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/save.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Save / Export..."; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+S"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    f-sav-touch := TouchArea {
                        clicked => { root.file-menu-open = false; root.save-image-clicked(); }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                Rectangle {
                    height: 26px;
                    background: f-ext-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/close.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #E06060;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Exit"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Alt+F4"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    f-ext-touch := TouchArea {
                        clicked => { root.file-menu-open = false; root.request-exit(); }
                    }
                }
            }
        }

        if root.edit-menu-open : Rectangle {
            x: edit-menu-btn.absolute-position.x;
            y: 28px;
            width: 240px;
            height: edit-menu-layout.preferred-height;
            background: #202020;
            border-width: 1px;
            border-color: #383838;
            border-radius: 3px;
            z: 100;

            edit-menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Undo
                Rectangle {
                    height: 26px;
                    background: e-undo-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/undo.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Undo"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+Z"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    e-undo-touch := TouchArea {
                        clicked => { root.edit-menu-open = false; root.undo-action(); }
                    }
                }

                // Redo
                Rectangle {
                    height: 26px;
                    background: e-redo-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/redo.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Redo"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+Y"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    e-redo-touch := TouchArea {
                        clicked => { root.edit-menu-open = false; root.redo-action(); }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                // Rename...
                Rectangle {
                    height: 26px;
                    background: e-ren-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/edit.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Rename..."; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "F2"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    e-ren-touch := TouchArea {
                        clicked => { root.edit-menu-open = false; root.request-rename(); }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                Rectangle {
                    height: 26px;
                    background: e-rcw-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/rotate_right.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Rotate Right"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "R"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    e-rcw-touch := TouchArea {
                        clicked => { root.edit-menu-open = false; root.rotate-cw(); }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: e-rccw-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/rotate_left.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Rotate Left"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "L"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    e-rccw-touch := TouchArea {
                        clicked => { root.edit-menu-open = false; root.rotate-ccw(); }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                Rectangle {
                    height: 26px;
                    background: e-del-touch.has-hover ? #7A1C1C : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/trash.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #FF8080;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Delete Selected"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Del"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    e-del-touch := TouchArea {
                        clicked => { root.edit-menu-open = false; root.delete-selected-images(); }
                    }
                }
            }
        }

        if root.view-menu-open : Rectangle {
            x: view-menu-btn.absolute-position.x;
            y: 28px;
            width: 250px;
            height: view-menu-layout.preferred-height;
            background: #202020;
            border-width: 1px;
            border-color: #383838;
            border-radius: 3px;
            z: 100;

            view-menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                Rectangle {
                    height: 26px;
                    background: v-fit-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image { source: @image-url("../assets/icons/expand.svg"); width: 14px; height: 14px; colorize: #CCCCCC; y: (parent.height - self.height) / 2.0; }
                        Text { horizontal-stretch: 1; text: "Fit to Screen"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+0"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    v-fit-touch := TouchArea {
                        clicked => { root.view-menu-open = false; root.zoom-fit-clicked(canvas-area.width / 1px, canvas-area.height / 1px); }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: v-100-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle { width: 14px; }
                        Text { horizontal-stretch: 1; text: "Actual Size (100%)"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Ctrl+1"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    v-100-touch := TouchArea {
                        clicked => { root.view-menu-open = false; root.zoom-100-clicked(); }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: v-zin-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image { source: @image-url("../assets/icons/zoom_in.svg"); width: 14px; height: 14px; colorize: #CCCCCC; y: (parent.height - self.height) / 2.0; }
                        Text { horizontal-stretch: 1; text: "Zoom In"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "+"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    v-zin-touch := TouchArea {
                        clicked => { root.view-menu-open = false; root.zoom-in-clicked(); }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: v-zout-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image { source: @image-url("../assets/icons/zoom_out.svg"); width: 14px; height: 14px; colorize: #CCCCCC; y: (parent.height - self.height) / 2.0; }
                        Text { horizontal-stretch: 1; text: "Zoom Out"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "-"; color: #888888; font-size: 12px; vertical-alignment: center; }
                    }
                    v-zout-touch := TouchArea {
                        clicked => { root.view-menu-open = false; root.zoom-out-clicked(); }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                Rectangle {
                    height: 26px;
                    background: v-tog-left.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: root.left-panel-visible ? "✓" : " ";
                            color: #5CBD50;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text { horizontal-stretch: 1; text: "Show Left Sidebar"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    v-tog-left := TouchArea {
                        clicked => { root.view-menu-open = false; root.left-panel-visible = !root.left-panel-visible; }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: v-tog-right.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: root.right-panel-visible ? "✓" : " ";
                            color: #5CBD50;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text { horizontal-stretch: 1; text: "Show Right Sidebar"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    v-tog-right := TouchArea {
                        clicked => { root.view-menu-open = false; root.right-panel-visible = !root.right-panel-visible; }
                    }
                }
            }
        }

        if root.help-menu-open : Rectangle {
            x: help-menu-btn.absolute-position.x;
            y: 28px;
            width: 250px;
            height: help-menu-layout.preferred-height;
            background: #202020;
            border-width: 1px;
            border-color: #383838;
            border-radius: 3px;
            z: 100;

            help-menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                Rectangle {
                    height: 26px;
                    background: h-sc-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/keyboard.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "Keyboard Shortcuts..."; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    h-sc-touch := TouchArea {
                        clicked => {
                            root.help-menu-open = false;
                            root.open-shortcuts-dialog();
                        }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                Rectangle {
                    height: 26px;
                    background: h-abt-touch.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Image {
                            source: @image-url("../assets/icons/info.svg");
                            width: 14px;
                            height: 14px;
                            colorize: #CCCCCC;
                            y: (parent.height - self.height) / 2.0;
                        }
                        Text { horizontal-stretch: 1; text: "About " + root.app-name + "…"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    h-abt-touch := TouchArea {
                        clicked => {
                            root.help-menu-open = false;
                            root.about-dialog-visible = true;
                        }
                    }
                }
            }
        }

        // Aspect Ratio Dropdown Menu (Dynamic Anchor to aspect-btn)
        if root.crop-aspect-menu-open : Rectangle {
            x: min(root.width - 250px, max(10px, aspect-btn.absolute-position.x));
            y: aspect-btn.absolute-position.y + aspect-btn.height + 4px;
            width: 240px;
            height: crop-menu-layout.preferred-height;
            background: #202020;
            border-width: 1px;
            border-color: #383838;
            border-radius: 3px;
            z: 100;

            crop-menu-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Custom Aspect Ratio...
                Rectangle {
                    height: 26px;
                    background: ar-custom-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { horizontal-stretch: 1; text: "Custom Aspect Ratio..."; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-custom-t := TouchArea {
                        clicked => {
                            root.crop-aspect-menu-open = false;
                            root.crop-custom-dialog-visible = true;
                        }
                    }
                }

                // Switch Crop Orientation
                Rectangle {
                    height: 26px;
                    background: ar-orient-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { horizontal-stretch: 1; text: "Switch Crop Orientation"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                        Text { text: "⇧+X"; color: #888888; font-size: 11px; vertical-alignment: center; }
                    }
                    ar-orient-t := TouchArea {
                        clicked => {
                            root.switch-crop-orientation();
                        }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                // Unconstrained (Default: a mano libera)
                Rectangle {
                    height: 26px;
                    background: ar-unc-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "Unconstrained") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "Unconstrained"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-unc-t := TouchArea {
                        clicked => { root.set-aspect-ratio("Unconstrained", 0.0); }
                    }
                }

                // Original
                Rectangle {
                    height: 26px;
                    background: ar-orig-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "Original") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "Original"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-orig-t := TouchArea {
                        clicked => { root.set-aspect-ratio("Original", -1.0); }
                    }
                }

                Rectangle { height: 1px; background: #2E2E2E; }

                // 1x1
                Rectangle {
                    height: 26px;
                    background: ar-11-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "1x1") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "1x1"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-11-t := TouchArea {
                        clicked => { root.set-aspect-ratio("1x1", 1.0); }
                    }
                }

                // 3x2
                Rectangle {
                    height: 26px;
                    background: ar-32-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "3x2") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "3x2"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-32-t := TouchArea {
                        clicked => { root.set-aspect-ratio("3x2", 3.0 / 2.0); }
                    }
                }

                // 4x3
                Rectangle {
                    height: 26px;
                    background: ar-43-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "4x3") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "4x3"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-43-t := TouchArea {
                        clicked => { root.set-aspect-ratio("4x3", 4.0 / 3.0); }
                    }
                }

                // 5x4
                Rectangle {
                    height: 26px;
                    background: ar-54-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "5x4") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "5x4"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-54-t := TouchArea {
                        clicked => { root.set-aspect-ratio("5x4", 5.0 / 4.0); }
                    }
                }

                // 16x9
                Rectangle {
                    height: 26px;
                    background: ar-169-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "16x9") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "16x9"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-169-t := TouchArea {
                        clicked => { root.set-aspect-ratio("16x9", 16.0 / 9.0); }
                    }
                }

                // 21x9
                Rectangle {
                    height: 26px;
                    background: ar-219-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "21x9") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "21x9"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-219-t := TouchArea {
                        clicked => { root.set-aspect-ratio("21x9", 21.0 / 9.0); }
                    }
                }

                // 65x24
                Rectangle {
                    height: 26px;
                    background: ar-6524-t.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            background: transparent;
                            Text {
                                text: (root.crop-aspect-label == "65x24") ? "✓" : "";
                                color: #5CBD50;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { horizontal-stretch: 1; text: "65x24"; color: #FFFFFF; font-size: 13px; vertical-alignment: center; }
                    }
                    ar-6524-t := TouchArea {
                        clicked => { root.set-aspect-ratio("65x24", 65.0 / 24.0); }
                    }
                }

                if (root.saved-custom-aspect-ratios.length > 0) : Rectangle { height: 1px; background: #2E2E2E; }

                // Saved Custom Aspect Ratios (Task 4 & 3, perfectly aligned in column)
                for custom_ar in root.saved-custom-aspect-ratios : Rectangle {
                    height: 26px;
                    background: c-ar-it.has-hover ? #2E2E2E : transparent;
                    border-radius: 2px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;

                        // Clickable area for applying preset
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 16px;
                                    background: transparent;
                                    Text {
                                        text: (root.crop-aspect-label == custom_ar) ? "✓" : "";
                                        color: #5CBD50;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: custom_ar;
                                    color: #FFFFFF;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                            c-ar-it := TouchArea {
                                clicked => {
                                    root.apply-custom-aspect-ratio(custom_ar);
                                }
                            }
                        }

                        // Independent delete button (does not trigger apply or close dropdown)
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            y: (parent.height - self.height) / 2.0;
                            background: del-car-t.has-hover ? #5A1E1E : transparent;
                            border-radius: 3px;
                            Text {
                                text: "×";
                                color: del-car-t.has-hover ? #FF6060 : #888888;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            del-car-t := TouchArea {
                                clicked => {
                                    root.delete-custom-aspect-ratio(custom_ar);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Custom Aspect Ratio Dialog Popup
        if root.crop-custom-dialog-visible : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000088;
            z: 120;

            TouchArea {}

            Rectangle {
                x: (parent.width - self.width) / 2.0;
                y: (parent.height - self.height) / 2.0;
                width: 380px;
                height: 190px;
                background: #202020;
                border-width: 1px;
                border-color: #404040;
                border-radius: 6px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Custom Aspect Ratio";
                            color: #FFFFFF;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 2px;
                            background: car-cls-t.has-hover ? #333333 : transparent;
                            Image {
                                source: @image-url("../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: #CCCCCC;
                                x: (parent.width - self.width) / 2.0;
                                y: (parent.height - self.height) / 2.0;
                            }
                            car-cls-t := TouchArea {
                                clicked => { root.crop-custom-dialog-visible = false; }
                            }
                        }
                    }

                    Text {
                        text: "Enter aspect ratio as Width x Height (e.g. 16x10, 21x9):";
                        color: #A0A0A0;
                        font-size: 11px;
                    }

                    Rectangle {
                        height: 30px;
                        background: #141414;
                        border-width: 1px;
                        border-color: #383838;
                        border-radius: 3px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            TextInput {
                                text <=> root.crop-custom-input;
                                color: #FFFFFF;
                                font-size: 13px;
                                vertical-alignment: center;
                                accepted => {
                                    root.apply-custom-aspect-ratio(self.text);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Win10Button {
                            text: "Save Preset";
                            height: 28px;
                            clicked => {
                                root.save-custom-aspect-ratio(root.crop-custom-input);
                                root.apply-custom-aspect-ratio(root.crop-custom-input);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Win10Button {
                            text: "Cancel";
                            height: 28px;
                            clicked => { root.crop-custom-dialog-visible = false; }
                        }
                        Win10Button {
                            text: "Apply";
                            primary: true;
                            height: 28px;
                            clicked => { root.apply-custom-aspect-ratio(root.crop-custom-input); }
                        }
                    }
                }
            }
        }

        // Keyboard Shortcuts Customizer Dialog (Task 2: FocusScope + Esc to dismiss)
        if root.shortcuts-dialog-visible : FocusScope {
            x: ((root.width - sc-window.width) / 2.0) + root.shortcuts-dialog-offset-x;
            y: ((root.height - sc-window.height) / 2.0) + root.shortcuts-dialog-offset-y;
            width: sc-window.width;
            height: sc-window.height;
            z: 200;

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.shortcuts-dialog-visible = false;
                    key-handler.focus();
                    return accept;
                }
                return reject;
            }

            sc-window := Rectangle {
                width: 580px;
                height: 520px;
                background: #1E1E1E;
                border-width: 1px;
                border-color: #383838;
                border-radius: 6px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Header with Drag Touch (Task 2)
                    Rectangle {
                        height: 42px;

                        sc-hdr-touch := TouchArea {
                            property <length> drag-start-x: 0px;
                            property <length> drag-start-y: 0px;
                            property <bool> is-dragging: false;

                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    self.is-dragging = true;
                                    self.drag-start-x = self.mouse-x;
                                    self.drag-start-y = self.mouse-y;
                                } else if (ev.kind == PointerEventKind.move && self.is-dragging) {
                                    root.shortcuts-dialog-offset-x += self.mouse-x - self.drag-start-x;
                                    root.shortcuts-dialog-offset-y += self.mouse-y - self.drag-start-y;
                                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                    self.is-dragging = false;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Keyboard Shortcuts Customization";
                                    color: #FFFFFF;
                                    font-size: 15px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Click on any key box to edit your preferred shortcut key combination";
                                    color: #9E9E9E;
                                    font-size: 12px;
                                }
                            }
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: sc-cls-t.has-hover ? #383838 : transparent;
                                border-radius: 3px;
                                Image {
                                    source: @image-url("../assets/icons/close.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: #CCCCCC;
                                    x: (parent.width - self.width) / 2.0;
                                    y: (parent.height - self.height) / 2.0;
                                }
                                sc-cls-t := TouchArea {
                                    clicked => { root.shortcuts-dialog-visible = false; }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #2E2E2E; }

                    // Scrollable Shortcuts Table with prominent custom scrollbar (Task 2 & 8)
                    Rectangle {
                        vertical-stretch: 1;
                        background: #141414;
                        border-width: 1px;
                        border-color: #282828;
                        border-radius: 4px;
                        clip: true;

                        sc-flick := Flickable {
                            width: parent.width - 18px;
                            height: 100%;
                            content-height: sc-layout.preferred-height;

                            sc-layout := VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                alignment: start;

                                for item[idx] in root.shortcut-items : Rectangle {
                                    height: 30px;
                                    background: Math.mod(idx, 2) == 0 ? #191919 : transparent;
                                    border-radius: 3px;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;

                                        Text {
                                            text: item.name;
                                            color: #E0E0E0;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        Rectangle {
                                            width: 136px;
                                            height: 24px;
                                            y: (parent.height - self.height) / 2.0;
                                            background: !item.is_valid ? #3A1414 : (sc-in.has-focus ? #182C40 : #242424);
                                            border-width: 1px;
                                            border-color: !item.is_valid ? #FF3B30 : (sc-in.has-focus ? #007ACC : #3A3A3A);
                                            border-radius: 3px;

                                            sc-in := TextInput {
                                                text: item.key_combo;
                                                color: !item.is_valid ? #FF8080 : #FFFFFF;
                                                font-size: 13px;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                key-pressed(event) => {
                                                    if (event.text == Key.Escape) {
                                                        root.shortcuts-dialog-visible = false;
                                                        key-handler.focus();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                                edited => {
                                                    root.update-shortcut-key(idx, self.text);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Prominent Custom Scrollbar Track & Thumb (Task 8: large, highly visible thumb)
                        sc-track := Rectangle {
                            x: parent.width - 14px;
                            y: 4px;
                            width: 10px;
                            height: parent.height - 8px;
                            background: #222222;
                            border-radius: 5px;

                            sc-thumb := Rectangle {
                                width: 8px;
                                x: 1px;
                                y: sc-flick.content-height > sc-flick.height ?
                                    (-sc-flick.content-y / (sc-flick.content-height - sc-flick.height)) * (sc-track.height - self.height) : 0px;
                                height: sc-flick.content-height > sc-flick.height ?
                                    Math.max(36px, (sc-flick.height / sc-flick.content-height) * sc-track.height) : sc-track.height;
                                background: sc-thumb-touch.has-hover ? #888888 : (sc-thumb-touch.pressed ? #AAAAAA : #555555);
                                border-width: 1px;
                                border-color: #777777;
                                border-radius: 4px;

                                sc-thumb-touch := TouchArea {
                                    moved => {
                                        if (sc-flick.content-height > sc-flick.height) {
                                            let track_h = sc-track.height - sc-thumb.height;
                                            if (track_h > 0px) {
                                                let new_y = (sc-thumb.y + self.mouse-y - self.pressed-y).clamp(0px, track_h);
                                                sc-flick.content-y = -(new_y / track_h) * (sc-flick.content-height - sc-flick.height);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Action buttons
                    HorizontalLayout {
                        spacing: 8px;
                        Win10Button {
                            text: "Reset to Defaults";
                            height: 28px;
                            clicked => { root.reset-shortcuts-to-default(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Win10Button {
                            text: "Cancel";
                            height: 28px;
                            clicked => { root.shortcuts-dialog-visible = false; }
                        }
                        Win10Button {
                            text: "Save & Close";
                            height: 32px;
                            primary: true;
                            clicked => {
                                root.save-shortcuts-and-close();
                                root.shortcuts-dialog-visible = false;
                                key-handler.focus();
                            }
                        }
                    }
                }
            }
        }

        // About Dialog Popup (Task 12)
        if root.about-dialog-visible : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000088;

            TouchArea {
                clicked => { root.about-dialog-visible = false; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2.0;
                y: (parent.height - self.height) / 2.0;
                width: 480px;
                height: 330px;
                background: #222222;
                border-width: 1px;
                border-color: #404040;
                border-radius: 6px;

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        Image {
                            source: @image-url("../assets/icon.png");
                            width: 52px;
                            height: 52px;
                            image-fit: contain;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.app-name;
                                color: #FFFFFF;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Version " + root.app-version + " (" + root.platform-label + ")";
                                color: #A0A0A0;
                                font-size: 13px;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #333333; }

                    Text {
                        text: "Color-Managed RAW & Image Viewer for Windows\n\n• LittleCMS 2 color engine with embedded ICC profile support\n• High-performance multi-threaded decoding & RAM caching\n• Formats: CR2, CR3, NEF, ARW, DNG, JPEG, PNG, TIFF, WebP, AVIF\n• Interactive 4x Loupe, Eyedropper, EXIF Inspector & Histogram\n• License: GNU General Public License v3.0 (GPLv3)";
                        color: #D0D0D0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Win10Button {
                            text: "Close";
                            primary: true;
                            clicked => { root.about-dialog-visible = false; }
                        }
                    }
                }
            }
        }

        // Exit Confirmation Dialog for Unsaved Modifications (Task 20)
        if root.exit-confirm-dialog-visible : Rectangle {
            width: 100%;
            height: 100%;
            background: #000000AA;
            z: 300;

            TouchArea {}

            Rectangle {
                x: (parent.width - self.width) / 2.0;
                y: (parent.height - self.height) / 2.0;
                width: 460px;
                height: 190px;
                background: #222222;
                border-width: 1px;
                border-color: #444444;
                border-radius: 6px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Image {
                            source: @image-url("../assets/icons/warning.svg");
                            width: 28px;
                            height: 28px;
                            colorize: #FFB900;
                            y: (parent.height - self.height) / 2.0;
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Unsaved Modifications";
                                color: #FFFFFF;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.exit-confirm-text;
                                color: #CCCCCC;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #333333; }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;

                        Win10Button {
                            text: "Save & Exit";
                            primary: true;
                            height: 30px;
                            clicked => {
                                root.exit-confirm-dialog-visible = false;
                                root.save-all-modified-and-exit();
                            }
                        }

                        Win10Button {
                            text: "Exit without Saving";
                            height: 30px;
                            clicked => {
                                root.exit-confirm-dialog-visible = false;
                                root.exit-app();
                            }
                        }

                        Win10Button {
                            text: "Cancel";
                            height: 30px;
                            clicked => {
                                root.exit-confirm-dialog-visible = false;
                            }
                        }
                    }
                }
            }
        }
}
